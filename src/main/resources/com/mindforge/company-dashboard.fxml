<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindforge.controllers.carriere.CompanyOwnerController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@styles.css"
      style="-fx-background-color: #f7f8fc;">

    <!-- Top Header - Gradient -->
    <HBox style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #e91e8c, #7c4dff, #00bcd4);
                 -fx-padding: 20 28 20 28;"
          alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label fx:id="pageTitle" text="My Companies"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="pageSubtitle" text="Company Owner"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="backBtn" text="← Back"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 8;"
                onAction="#goBack" visible="false" managed="false"/>
        <Button fx:id="actionBtn" text="+ Add Company"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 8;"/>
        <Button text="Logout" onAction="#logout"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 8;"/>
    </HBox>

    <!-- Cards Scroll Area -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="false"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <FlowPane fx:id="cardsFlow" hgap="20" vgap="20"
                  style="-fx-padding: 28; -fx-background-color: transparent;"/>
    </ScrollPane>

</VBox>
