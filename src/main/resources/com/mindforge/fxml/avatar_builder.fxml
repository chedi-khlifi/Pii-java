<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.architect.controller.AvatarBuilderController"
            style="-fx-background-color: #ececf2;">

    <!-- ══ TOP BAR ══════════════════════════════════════════════════ -->
    <top>
        <HBox style="-fx-background-color: #1e1e2e; -fx-border-color: transparent transparent #333 transparent; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="🔥 MindForge" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #cdd3e0; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 12;"/>
        </HBox>
    </top>

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent #e1e3ef transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="210" maxWidth="210" spacing="5">
            <padding><Insets top="14" right="12" bottom="14" left="12"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="8" right="10" bottom="10" left="10"/></padding>
                <Label text="🔥" style="-fx-font-size: 20px;"/>
                <Label text="MindForge" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #21273b;"/>
            </HBox>
            <VBox spacing="5">
                <Button text="🏠  Dashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📁  Planner"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="👥  Community"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📚  Guardian"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="💼  Careers"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            </VBox>
            <Region minHeight="20"/>
            <Label text="QUICK LINKS" style="-fx-text-fill: #a0a5b8; -fx-font-weight: 700; -fx-font-size: 11px;">
                <padding><Insets bottom="6" left="8" right="8" top="0"/></padding>
            </Label>
            <Button text="← Back to Profile" onAction="#goBack"
                    style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f5fa; -fx-background: #f5f5fa; -fx-border-color: transparent;">
            <VBox spacing="14" style="-fx-padding: 16 16 32 16; -fx-background-color: #f5f5fa;">

                <!-- Gradient hero banner -->
                <VBox style="-fx-background-color: linear-gradient(to right, #eb5fac, #8185ff 54%, #86d8ea); -fx-background-radius: 12;" spacing="4">
                    <padding><Insets bottom="18" left="20" right="20" top="18"/></padding>
                    <Label text="🎨 Avatar Builder" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Customize your avatar style, seed and appearance." style="-fx-text-fill: white; -fx-opacity: 0.92; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Main layout: preview left, controls right -->
                <HBox spacing="16" alignment="TOP_LEFT">

                    <!-- Preview panel -->
                    <VBox spacing="12" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 24 20;"
                          prefWidth="220">
                        <Label text="PREVIEW" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>
                        <ImageView fx:id="previewImage" fitWidth="150" fitHeight="150" preserveRatio="true"/>
                        <Button text="🎲 Random seed" onAction="#handleRandomSeed"
                                style="-fx-background-color: transparent; -fx-border-color: #e0e3ef; -fx-border-width: 1; -fx-border-radius: 8; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
                    </VBox>

                    <!-- Controls panel -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 20 22;">
                        <Label text="AVATAR OPTIONS" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>

                        <VBox spacing="4">
                            <Label text="Avatar style" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                            <ComboBox fx:id="comboStyle" maxWidth="Infinity" style="-fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Seed (name / word)" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                            <TextField fx:id="fieldSeed" promptText="e.g. mindforge42"
                                       style="-fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e3ef; -fx-border-width: 1;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Background color" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                            <ComboBox fx:id="comboBgColor" maxWidth="Infinity" style="-fx-font-size: 13px;"/>
                        </VBox>
                        <HBox spacing="20">
                            <CheckBox fx:id="checkFlip"  text="Flip"        style="-fx-font-size: 13px;"/>
                            <CheckBox fx:id="checkRound" text="Round shape" style="-fx-font-size: 13px;"/>
                        </HBox>

                        <Button text="👁 Preview" onAction="#handlePreview"
                                style="-fx-background-color: transparent; -fx-border-color: #534AB7; -fx-border-width: 1; -fx-border-radius: 8; -fx-text-fill: #534AB7; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 7 20;"/>

                        <Label fx:id="labelMessage" text="" wrapText="true" style="-fx-font-size: 13px;"/>

                        <Button text="💾 Save avatar" onAction="#handleSave"
                                style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 9 20;"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent transparent transparent #e1e3ef; -fx-border-width: 0 0 0 1;"
              minWidth="220" maxWidth="220" spacing="12">
            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Avatar Styles" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button text="← Back to Profile" onAction="#goBack"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #534AB7; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="🎲 Random seed" onAction="#handleRandomSeed"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="👁 Preview" onAction="#handlePreview"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="💾 Save avatar" onAction="#handleSave"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>
