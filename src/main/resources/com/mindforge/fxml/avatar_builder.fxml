<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.controller.AvatarBuilderController"
            style="-fx-background-color: #f5f5f5; -fx-border-color: transparent; -fx-background: #f5f5f5;">

    <VBox spacing="14" style="-fx-padding: 24 28 32 28; -fx-max-width: 640;">

        <!-- ══ HEADER ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 6 0;">
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-border-color: #cccccc;
                           -fx-border-radius: 8; -fx-border-width: 0.5;
                           -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
            <Label text="Avatar Builder"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </HBox>

        <!-- ══ MAIN LAYOUT: preview left, controls right ════════════════ -->
        <HBox spacing="20" alignment="TOP_LEFT">

            <!-- Preview panel -->
            <VBox spacing="12" alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-border-color: #e0e0e0; -fx-border-width: 0.5;
                         -fx-border-radius: 12; -fx-padding: 24 20;"
                  prefWidth="200">
                <Label text="PREVIEW"
                       style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa; -fx-font-weight: bold;"/>
                <ImageView fx:id="previewImage"
                           fitWidth="150" fitHeight="150"
                           preserveRatio="true"/>
                <Button text="Random seed" onAction="#handleRandomSeed"
                        style="-fx-background-color: transparent; -fx-border-color: #cccccc;
                               -fx-border-width: 0.5; -fx-border-radius: 8;
                               -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
            </VBox>

            <!-- Controls panel -->
            <VBox spacing="12" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-border-color: #e0e0e0; -fx-border-width: 0.5;
                         -fx-border-radius: 12; -fx-padding: 20 22;">

                <!-- Style -->
                <VBox spacing="4">
                    <Label text="Avatar style"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                    <ComboBox fx:id="comboStyle" maxWidth="Infinity"
                              style="-fx-font-size: 13px;"/>
                </VBox>

                <!-- Seed -->
                <VBox spacing="4">
                    <Label text="Seed (name / word)"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                    <TextField fx:id="fieldSeed"
                               promptText="e.g. mindforge42"
                               style="-fx-font-size: 13px; -fx-padding: 7 10;
                                      -fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #e0e0e0; -fx-border-width: 0.5;"/>
                </VBox>

                <!-- Background color -->
                <VBox spacing="4">
                    <Label text="Background color"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                    <ComboBox fx:id="comboBgColor" maxWidth="Infinity"
                              style="-fx-font-size: 13px;"/>
                </VBox>

                <!-- Options -->
                <HBox spacing="20">
                    <CheckBox fx:id="checkFlip"  text="Flip"        style="-fx-font-size: 13px;"/>
                    <CheckBox fx:id="checkRound" text="Round shape" style="-fx-font-size: 13px;"/>
                </HBox>

                <!-- Preview button -->
                <Button text="Preview" onAction="#handlePreview"
                        style="-fx-background-color: transparent; -fx-border-color: #534AB7;
                               -fx-border-width: 0.5; -fx-border-radius: 8;
                               -fx-text-fill: #534AB7; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-padding: 7 20;"/>

                <!-- Message -->
                <Label fx:id="labelMessage" text=""
                       wrapText="true" style="-fx-font-size: 13px;"/>

                <!-- Save -->
                <Button text="Save avatar" onAction="#handleSave"
                        style="-fx-background-color: #534AB7; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-padding: 9 20;"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
