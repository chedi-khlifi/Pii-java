<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
    Login page — full-window split layout.
    Left  : dark branded panel with tagline + feature bullets
    Right : clean white card with form
    Size  : fills whatever scene size is set (min 900×600)
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindforge.architect.controller.LoginController"
      minWidth="900" minHeight="600"
      style="-fx-background-color: #0f0f1a;">

    <!-- ══════════════════════════════════════════════════════════
         LEFT PANEL — brand + features
    ══════════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS"
          alignment="CENTER_LEFT"
          spacing="0"
          style="-fx-background-color: linear-gradient(to bottom right, #1a1040, #2d1b6e, #1e1e3a);
                 -fx-min-width: 420; -fx-max-width: 560;">
        <padding><Insets top="60" right="56" bottom="60" left="56"/></padding>

        <!-- Logo mark -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🔥"  style="-fx-font-size: 32px;"/>
            <Label text="MindForge"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>

        <Region minHeight="40"/>

        <!-- Headline -->
        <Label text="Your mental workspace."
               wrapText="true"
               style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: white;
                      -fx-line-spacing: 4;"/>
        <Label text="Focus. Grow. Thrive."
               style="-fx-font-size: 18px; -fx-text-fill: #c4b5fd; -fx-padding: 10 0 0 0;"/>

        <Region minHeight="48"/>

        <!-- Feature bullets -->
        <VBox spacing="18">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="⚡"  style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="AI-Powered Insights"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Detect your mood and get personalised mental health support."
                           wrapText="true" maxWidth="320"
                           style="-fx-font-size: 12px; -fx-text-fill: #a5b4fc;"/>
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="🎯"  style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="Smart Planner"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Manage tasks, exams and focus sessions in one place."
                           wrapText="true" maxWidth="320"
                           style="-fx-font-size: 12px; -fx-text-fill: #a5b4fc;"/>
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="👥"  style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="Community &amp; Careers"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Connect with peers, explore opportunities and grow together."
                           wrapText="true" maxWidth="320"
                           style="-fx-font-size: 12px; -fx-text-fill: #a5b4fc;"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Footer note -->
        <Label text="Trusted by students and professionals."
               style="-fx-font-size: 11px; -fx-text-fill: #6d6d8a;"/>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         RIGHT PANEL — login form
    ══════════════════════════════════════════════════════════ -->
    <StackPane HBox.hgrow="ALWAYS"
               alignment="CENTER"
               style="-fx-background-color: #f5f5fa;">

        <VBox spacing="0"
              alignment="TOP_CENTER"
              maxWidth="420" minWidth="340"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 30, 0, 0, 8);">
            <padding><Insets top="44" right="44" bottom="44" left="44"/></padding>

            <!-- Form header -->
            <Label text="Welcome back 👋"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
            <Label text="Sign in to your MindForge account"
                   style="-fx-font-size: 13px; -fx-text-fill: #6d748a; -fx-padding: 6 0 28 0;"/>

            <!-- Email label + field -->
            <Label text="Email address"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 0 0 6 0;"/>
            <TextField fx:id="emailField"
                       promptText="you@example.com"
                       maxWidth="Infinity"
                       style="-fx-background-color: #f9fafb;
                              -fx-border-color: #e1e3ef;
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 12 14; -fx-font-size: 14px;
                              -fx-text-fill: #21273b; -fx-prompt-text-fill: #9ca3af;"/>

            <!-- Password label + field -->
            <Label text="Password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 18 0 6 0;"/>
            <PasswordField fx:id="passwordField"
                           promptText="••••••••"
                           maxWidth="Infinity"
                           style="-fx-background-color: #f9fafb;
                                  -fx-border-color: #e1e3ef;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 12 14; -fx-font-size: 14px;
                                  -fx-text-fill: #21273b; -fx-prompt-text-fill: #9ca3af;"/>

            <!-- Forgot password -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                <Hyperlink text="Forgot password?"
                           onAction="#showForgotPasswordDialog"
                           style="-fx-text-fill: #534AB7; -fx-font-size: 12px;
                                  -fx-border-color: transparent; -fx-padding: 0;"/>
            </HBox>

            <!-- Message label -->
            <Label fx:id="messageLabel" text=""
                   wrapText="true" maxWidth="Infinity"
                   style="-fx-font-size: 12px; -fx-padding: 10 0 0 0;"/>

            <!-- Login button -->
            <Button text="Sign In"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    style="-fx-background-color: #534AB7;
                           -fx-text-fill: white;
                           -fx-font-size: 15px; -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 13 0;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(83,74,183,0.35), 12, 0, 0, 4);">
                <VBox.margin><Insets top="20"/></VBox.margin>
            </Button>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 20 0;">
                <Line endX="120" stroke="#e1e3ef" strokeWidth="1"/>
                <Label text="or" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                <Line endX="120" stroke="#e1e3ef" strokeWidth="1"/>
            </HBox>

            <!-- Register button -->
            <Button text="Create a new account"
                    onAction="#goToRegister"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #534AB7;
                           -fx-border-color: #534AB7;
                           -fx-border-radius: 10; -fx-background-radius: 10;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 12 0; -fx-cursor: hand;"/>

        </VBox>
    </StackPane>

</HBox>
