<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindforge.controller.SetupPasswordController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #1e1e2e; -fx-padding: 40;">

    <Label text="🔐 Set Your Password"
           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Create a password for your account:"
           style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;"/>

    <PasswordField fx:id="passwordField"
                   promptText="Enter password"
                   prefWidth="300"
                   style="-fx-background-color: #2e2e3e; -fx-text-fill: white;
                          -fx-prompt-text-fill: #666; -fx-border-color: #555;
                          -fx-border-radius: 5; -fx-background-radius: 5;
                          -fx-padding: 10; -fx-font-size: 14px;"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm password"
                   prefWidth="300"
                   style="-fx-background-color: #2e2e3e; -fx-text-fill: white;
                          -fx-prompt-text-fill: #666; -fx-border-color: #555;
                          -fx-border-radius: 5; -fx-background-radius: 5;
                          -fx-padding: 10; -fx-font-size: 14px;"/>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 13px;"
           wrapText="true"
           maxWidth="300"/>

    <Button text="Set Password"
            onAction="#handleSetPassword"
            prefWidth="300"
            style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                   -fx-font-size: 15px; -fx-font-weight: bold;
                   -fx-background-radius: 8; -fx-padding: 10 40 10 40;
                   -fx-cursor: hand;"/>

</VBox>