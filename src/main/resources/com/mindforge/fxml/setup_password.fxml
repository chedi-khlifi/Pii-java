<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mindforge.architect.controller.SetupPasswordController"
           style="-fx-background-color: #ececf2;">

    <VBox alignment="CENTER" spacing="0" maxWidth="480">

        <!-- ══ Card ══════════════════════════════════════════════════ -->
        <VBox spacing="20"
              style="-fx-background-color: white;
                     -fx-background-radius: 16;
                     -fx-border-color: #e0e3ef;
                     -fx-border-radius: 16;
                     -fx-border-width: 1;
                     -fx-padding: 36 40 36 40;
                     -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.10), 30, 0, 0, 14);">

            <!-- Header -->
            <VBox spacing="6" alignment="CENTER">
                <Label text="🔐 Set Your Password"
                       style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #0f172a;"/>
                <Label text="Create a strong password to secure your account."
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;" wrapText="true"/>
            </VBox>

            <!-- Password field -->
            <VBox spacing="6">
                <Label text="Password"
                       style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter password"
                               maxWidth="Infinity"
                               style="-fx-background-color: #f8fafc;
                                      -fx-border-color: #e2e8f0;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-padding: 11 14;
                                      -fx-font-size: 14px;"/>
            </VBox>

            <!-- Confirm password field -->
            <VBox spacing="6">
                <Label text="Confirm Password"
                       style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirm password"
                               maxWidth="Infinity"
                               style="-fx-background-color: #f8fafc;
                                      -fx-border-color: #e2e8f0;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-padding: 11 14;
                                      -fx-font-size: 14px;"/>
            </VBox>

            <!-- Message -->
            <Label fx:id="messageLabel"
                   text=""
                   style="-fx-font-size: 13px;"
                   wrapText="true"
                   maxWidth="Infinity"/>

            <!-- Submit button -->
            <Button text="Set Password"
                    onAction="#handleSetPassword"
                    maxWidth="Infinity"
                    style="-fx-background-color: #4f46e5;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: 700;
                           -fx-background-radius: 10;
                           -fx-padding: 12;
                           -fx-cursor: hand;"/>

        </VBox>
    </VBox>

</StackPane>