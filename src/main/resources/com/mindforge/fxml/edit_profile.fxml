<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.architect.controller.EditProfileController"
            style="-fx-background-color: #ececf2;">

    <!-- ══ TOP BAR ══════════════════════════════════════════════════ -->
    <top>
        <HBox style="-fx-background-color: #1e1e2e; -fx-border-color: transparent transparent #333 transparent; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="🔥 MindForge" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #cdd3e0; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 12;">
                <text>← Back to Profile</text>
            </Button>
        </HBox>
    </top>

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent #e1e3ef transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="210" maxWidth="210" spacing="5">
            <padding><Insets top="14" right="12" bottom="14" left="12"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="8" right="10" bottom="10" left="10"/></padding>
                <Label text="🔥" style="-fx-font-size: 20px;"/>
                <Label text="MindForge" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #21273b;"/>
            </HBox>
            <VBox spacing="5">
                <Button text="🏠  Dashboard" onAction="#goToDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📁  Planner"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="👥  Community"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📚  Guardian"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="💼  Careers"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            </VBox>
            <Region minHeight="20"/>
            <Label text="QUICK LINKS" style="-fx-text-fill: #a0a5b8; -fx-font-weight: 700; -fx-font-size: 11px;">
                <padding><Insets bottom="6" left="8" right="8" top="0"/></padding>
            </Label>
            <Button text="← Back to Profile" onAction="#goBack"
                    style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f5fa; -fx-background: #f5f5fa; -fx-border-color: transparent;">
            <VBox spacing="14" style="-fx-padding: 16 16 32 16; -fx-background-color: #f5f5fa;">

                <!-- Gradient hero banner -->
                <VBox style="-fx-background-color: linear-gradient(to right, #eb5fac, #8185ff 54%, #86d8ea); -fx-background-radius: 12;" spacing="4">
                    <padding><Insets bottom="18" left="20" right="20" top="18"/></padding>
                    <Label text="Edit Profile" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Update your personal information and profile photo." style="-fx-text-fill: white; -fx-opacity: 0.92; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Avatar section -->
                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 20 22;">
                    <Label text="PROFILE PHOTO" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>
                    <StackPane alignment="CENTER" style="-fx-padding: 6 0;">
                        <Circle fx:id="avatarCircle" radius="52" style="-fx-fill: #e8e6f8; -fx-stroke: #534AB7; -fx-stroke-width: 2.5;"/>
                        <ImageView fx:id="avatarImageView" fitWidth="104" fitHeight="104" preserveRatio="false" clip="$avatarClip"/>
                        <Label fx:id="avatarPlaceholder" text="👤" style="-fx-font-size: 38px;"/>
                    </StackPane>
                    <Circle fx:id="avatarClip" radius="52" visible="false"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="📷  Upload Photo" onAction="#handleUploadPhoto"
                                style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 18;"/>
                        <Button fx:id="btnRemovePhoto" text="Remove" onAction="#handleRemovePhoto"
                                visible="false" managed="false"
                                style="-fx-background-color: transparent; -fx-border-color: #cc4444; -fx-border-width: 0.5; -fx-border-radius: 8; -fx-text-fill: #cc4444; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 7 18;"/>
                    </HBox>
                    <Label fx:id="labelPhotoHint" text="JPG, PNG or GIF · max 5 MB" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8;"/>
                </VBox>

                <!-- Form card -->
                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 20 22;">
                    <Label text="PERSONAL INFORMATION" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>

                    <VBox spacing="4">
                        <Label text="First name" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                        <TextField fx:id="fieldFirstName" promptText="Enter first name"
                                   style="-fx-font-size: 14px; -fx-padding: 8 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e3ef; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Last name" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                        <TextField fx:id="fieldLastName" promptText="Enter last name"
                                   style="-fx-font-size: 14px; -fx-padding: 8 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e3ef; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Bio" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                        <TextArea fx:id="fieldBio" promptText="Tell others a bit about yourself..." prefRowCount="4" wrapText="true"
                                  style="-fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e3ef; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Timezone" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                        <ComboBox fx:id="comboTimezone" maxWidth="Infinity" style="-fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Locale" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                        <ComboBox fx:id="comboLocale" maxWidth="Infinity" style="-fx-font-size: 13px;"/>
                    </VBox>

                    <Label fx:id="labelMessage" text="" style="-fx-font-size: 13px;" wrapText="true"/>

                    <HBox spacing="10">
                        <Button text="Save changes" onAction="#handleSave"
                                style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 20;"/>
                        <Button text="Change avatar" onAction="#goToAvatarBuilder"
                                style="-fx-background-color: transparent; -fx-border-color: #534AB7; -fx-border-width: 1; -fx-border-radius: 8; -fx-text-fill: #534AB7; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 7 20;"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent transparent transparent #e1e3ef; -fx-border-width: 0 0 0 1;"
              minWidth="240" maxWidth="240" spacing="12">
            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Profile Actions" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button text="← Back to Profile" onAction="#goBack"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #534AB7; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                    <Button text="🎨 Avatar Builder" onAction="#goToAvatarBuilder"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                    <Button text="🏠 Dashboard" onAction="#goToDashboard"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>
