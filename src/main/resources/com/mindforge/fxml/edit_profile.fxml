<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.architect.controller.EditProfileController"
            style="-fx-background-color: #ececf2; -fx-border-color: transparent; -fx-background: #ececf2;">

    <VBox spacing="14" style="-fx-padding: 24 28 32 28;">

        <!-- ══ HEADER ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 0 0 6 0;">
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-border-color: #cccccc;
                           -fx-border-radius: 8; -fx-border-width: 0.5;
                           -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
            <Label text="Edit Profile"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </HBox>

        <!-- ══ AVATAR SECTION ═══════════════════════════════════════════ -->
        <VBox spacing="10" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e0e0e0; -fx-border-width: 0.5;
                     -fx-border-radius: 12; -fx-padding: 20 22;">

            <Label text="Profile Photo"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

            <StackPane alignment="CENTER" style="-fx-padding: 6 0;">
                <!-- Avatar circle container -->
                <Circle fx:id="avatarCircle" radius="52"
                        style="-fx-fill: #e8e6f8; -fx-stroke: #534AB7; -fx-stroke-width: 2.5;"/>
                <!-- Avatar image view (clipped to circle) -->
                <ImageView fx:id="avatarImageView"
                           fitWidth="104" fitHeight="104"
                           preserveRatio="false"
                           clip="$avatarClip"/>
                <!-- Placeholder icon label (shown when no avatar) -->
                <Label fx:id="avatarPlaceholder" text="👤"
                       style="-fx-font-size: 38px;"/>
            </StackPane>

            <!-- Hidden clip node for ImageView -->
            <Circle fx:id="avatarClip" radius="52" visible="false"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="📷  Upload Photo" onAction="#handleUploadPhoto"
                        style="-fx-background-color: #534AB7; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-padding: 8 18;"/>
                <Button fx:id="btnRemovePhoto" text="Remove" onAction="#handleRemovePhoto"
                        visible="false" managed="false"
                        style="-fx-background-color: transparent; -fx-border-color: #cc4444;
                               -fx-border-width: 0.5; -fx-border-radius: 8;
                               -fx-text-fill: #cc4444; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-padding: 7 18;"/>
            </HBox>

            <Label fx:id="labelPhotoHint" text="JPG, PNG or GIF · max 5 MB"
                   style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;"/>
        </VBox>

        <!-- ══ FORM CARD ════════════════════════════════════════════════ -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e0e0e0; -fx-border-width: 0.5;
                     -fx-border-radius: 12; -fx-padding: 20 22;">

            <!-- First Name -->
            <VBox spacing="4">
                <Label text="First name"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                <TextField fx:id="fieldFirstName"
                           promptText="Enter first name"
                           style="-fx-font-size: 14px; -fx-padding: 8 10;
                                  -fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #e0e0e0; -fx-border-width: 0.5;"/>
            </VBox>

            <!-- Last Name -->
            <VBox spacing="4">
                <Label text="Last name"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                <TextField fx:id="fieldLastName"
                           promptText="Enter last name"
                           style="-fx-font-size: 14px; -fx-padding: 8 10;
                                  -fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #e0e0e0; -fx-border-width: 0.5;"/>
            </VBox>

            <!-- Bio -->
            <VBox spacing="4">
                <Label text="Bio"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                <TextArea fx:id="fieldBio"
                          promptText="Tell others a bit about yourself..."
                          prefRowCount="4"
                          wrapText="true"
                          style="-fx-font-size: 13px; -fx-padding: 8 10;
                                 -fx-background-radius: 8; -fx-border-radius: 8;
                                 -fx-border-color: #e0e0e0; -fx-border-width: 0.5;"/>
            </VBox>

            <!-- Timezone -->
            <VBox spacing="4">
                <Label text="Timezone"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                <ComboBox fx:id="comboTimezone" maxWidth="Infinity"
                          style="-fx-font-size: 13px;"/>
            </VBox>

            <!-- Locale -->
            <VBox spacing="4">
                <Label text="Locale"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                <ComboBox fx:id="comboLocale" maxWidth="Infinity"
                          style="-fx-font-size: 13px;"/>
            </VBox>

            <!-- Message -->
            <Label fx:id="labelMessage" text=""
                   style="-fx-font-size: 13px;" wrapText="true"/>

            <!-- Actions -->
            <HBox spacing="10">
                <Button text="Save changes" onAction="#handleSave"
                        style="-fx-background-color: #534AB7; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-padding: 8 20;"/>
                <Button text="Change avatar" onAction="#goToAvatarBuilder"
                        style="-fx-background-color: transparent; -fx-border-color: #534AB7;
                               -fx-border-width: 0.5; -fx-border-radius: 8;
                               -fx-text-fill: #534AB7; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-padding: 7 20;"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
