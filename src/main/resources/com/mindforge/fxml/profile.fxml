<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.architect.controller.ProfileController"
            style="-fx-background-color: #ececf2;">

    <!-- ══ TOP BAR ══════════════════════════════════════════════════ -->
    <top>
        <HBox style="-fx-background-color: #1e1e2e; -fx-border-color: transparent transparent #333 transparent; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>

            <StackPane>
                <Circle fx:id="avatarCircleTop" radius="18" fill="#7c3aed"/>
                <Label fx:id="avatarInitialsTop" text="?" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <ImageView fx:id="avatarImageTop" fitWidth="36" fitHeight="36" preserveRatio="false" visible="false"/>
            </StackPane>
            <VBox spacing="1">
                <Label text="Welcome back," style="-fx-text-fill: #a0a5b8; -fx-font-size: 11px;"/>
                <Label fx:id="labelTopName" text="Loading..." style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="6" alignment="CENTER"
                  style="-fx-background-color: rgba(124,58,237,0.25); -fx-background-radius: 20; -fx-padding: 5 14;">
                <Label text="⚡" style="-fx-font-size: 13px;"/>
                <Label fx:id="labelXpTop" text="0 XP" style="-fx-text-fill: #c4b5fd; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="6" alignment="CENTER"
                  style="-fx-background-color: rgba(99,102,241,0.25); -fx-background-radius: 20; -fx-padding: 5 14;">
                <Label text="🏅" style="-fx-font-size: 13px;"/>
                <Label fx:id="labelLevelTop" text="Lv 1" style="-fx-text-fill: #a5b4fc; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="6" alignment="CENTER"
                  style="-fx-background-color: rgba(234,88,12,0.25); -fx-background-radius: 20; -fx-padding: 5 14;">
                <Label text="🔥" style="-fx-font-size: 13px;"/>
                <Label fx:id="labelStreakTop" text="0 days" style="-fx-text-fill: #fdba74; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>

            <Button onAction="#handleLogout"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;">
                <text>Logout</text>
            </Button>
        </HBox>
    </top>

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent #e1e3ef transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="210" maxWidth="210" spacing="5">
            <padding><Insets top="14" right="12" bottom="14" left="12"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="8" right="10" bottom="10" left="10"/></padding>
                <Label text="🔥" style="-fx-font-size: 20px;"/>
                <Label text="MindForge" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #21273b;"/>
            </HBox>

            <VBox spacing="5">
                <Button onAction="#goToDashboard" text="🏠  Dashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📁  Planner"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="👥  Community"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📚  Guardian"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="💼  Careers"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📊  Analyst"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            </VBox>

            <Region minHeight="20"/>

            <Label text="QUICK LINKS" style="-fx-text-fill: #a0a5b8; -fx-font-weight: 700; -fx-font-size: 11px;">
                <padding><Insets bottom="6" left="8" right="8" top="0"/></padding>
            </Label>
            <Button text="Contact Support"
                    style="-fx-background-color: transparent; -fx-text-fill: #6a7186; -fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            <Button onAction="#goToSocialHub" text="Friends"
                    style="-fx-background-color: transparent; -fx-text-fill: #6a7186; -fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            <Button text="Leaderboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #6a7186; -fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            <Button onAction="#goToSocialHub" text="🌐 Social Hub"
                    style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f5fa; -fx-background: #f5f5fa; -fx-border-color: transparent;">
            <VBox spacing="14" style="-fx-padding: 16 16 32 16; -fx-background-color: #f5f5fa;">

                <!-- Gradient hero banner -->
                <VBox style="-fx-background-color: linear-gradient(to right, #eb5fac, #8185ff 54%, #86d8ea); -fx-background-radius: 12;" spacing="4">
                    <padding><Insets bottom="18" left="20" right="20" top="18"/></padding>
                    <Label text="My Profile" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Manage your account, stats and personal information." style="-fx-text-fill: white; -fx-opacity: 0.92; -fx-font-size: 13px;"/>
                </VBox>

                <!-- ══ HEADER CARD ══ -->
                <HBox spacing="16" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #e0e3ef; -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 18 20;">
                    <StackPane fx:id="avatarPane" prefWidth="76" prefHeight="76">
                        <Circle radius="38" style="-fx-fill: #EEEDFE; -fx-stroke: #534AB7; -fx-stroke-width: 2;"/>
                        <Label fx:id="avatarInitials" text="?" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3C3489;"/>
                        <ImageView fx:id="avatarImage" fitWidth="76" fitHeight="76" preserveRatio="false" visible="false"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="labelFullName" text="Loading..." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                        <Label fx:id="labelEmail" text="" style="-fx-font-size: 13px; -fx-text-fill: #6d748a;"/>
                        <Label fx:id="labelRole" text="" style="-fx-font-size: 11px; -fx-background-color: #EEEDFE; -fx-text-fill: #534AB7; -fx-background-radius: 10; -fx-padding: 2 10;"/>
                    </VBox>
                    <VBox spacing="6" alignment="TOP_RIGHT">
                        <Button fx:id="btnSocialHub" text="🌐 Social Hub" onAction="#goToSocialHub"
                                style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 14;"/>
                        <Button text="Edit profile" onAction="#goToEditProfile"
                                style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 14;"/>
                        <Button text="Change avatar" onAction="#goToAvatarBuilder"
                                style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-border-width: 0.5; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 14;"/>
                        <Button text="Logout" onAction="#handleLogout"
                                style="-fx-background-color: transparent; -fx-border-color: #e0e3ef; -fx-border-radius: 8; -fx-border-width: 0.5; -fx-font-size: 12px; -fx-text-fill: #888888; -fx-cursor: hand; -fx-padding: 5 14;"/>
                    </VBox>
                    <Button fx:id="btnMentalHealth" text="🧠 Mental Health Check" onAction="#goToEmotions"
                            style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 14;"/>
                </HBox>

                <!-- ══ STATS ROW ══ -->
                <HBox spacing="10">
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 10;">
                        <Label fx:id="labelXP" text="—" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                        <Label text="Total XP" style="-fx-font-size: 11px; -fx-text-fill: #6d748a;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 10;">
                        <Label fx:id="labelLevel" text="—" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                        <Label text="Level" style="-fx-font-size: 11px; -fx-text-fill: #6d748a;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 10;">
                        <Label fx:id="labelTasks" text="—" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                        <Label text="Tasks done" style="-fx-font-size: 11px; -fx-text-fill: #6d748a;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 10;">
                        <Label fx:id="labelFocus" text="—" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                        <Label text="Focus time" style="-fx-font-size: 11px; -fx-text-fill: #6d748a;"/>
                    </VBox>
                </HBox>

                <!-- ══ XP PROGRESS ══ -->
                <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 16;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="XP PROGRESS" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="xpBarLabel" text="0 / 500 XP" style="-fx-font-size: 11px; -fx-text-fill: #6d748a;"/>
                    </HBox>
                    <ProgressBar fx:id="xpBar" progress="0" maxWidth="Infinity" style="-fx-accent: #534AB7; -fx-pref-height: 10px;"/>
                </VBox>

                <!-- ══ BADGES ══ -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 16;">
                    <Label text="BADGES" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>
                    <FlowPane fx:id="badgesPane" hgap="10" vgap="10"/>
                </VBox>

                <!-- ══ ACCOUNT INFO ══ -->
                <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 16;">
                    <Label text="ACCOUNT INFO" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                    <HBox style="-fx-border-color: transparent transparent #f0f0f0 transparent; -fx-padding: 8 0;">
                        <Label text="Timezone" style="-fx-font-size: 13px; -fx-text-fill: #6d748a;" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelTimezone" text="—" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                    </HBox>
                    <HBox style="-fx-border-color: transparent transparent #f0f0f0 transparent; -fx-padding: 8 0;">
                        <Label text="Locale" style="-fx-font-size: 13px; -fx-text-fill: #6d748a;" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelLocale" text="—" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                    </HBox>
                    <HBox style="-fx-border-color: transparent transparent #f0f0f0 transparent; -fx-padding: 8 0;">
                        <Label text="Member since" style="-fx-font-size: 13px; -fx-text-fill: #6d748a;" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelSince" text="—" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                    </HBox>
                    <HBox style="-fx-padding: 8 0;">
                        <Label text="Streak" style="-fx-font-size: 13px; -fx-text-fill: #6d748a;" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelStreak" text="—" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                    </HBox>
                </VBox>

                <!-- ══ BIO ══ -->
                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 16;">
                    <Label text="BIO" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelBio" text="No bio yet." wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #555555; -fx-line-spacing: 3;"/>
                </VBox>

                <!-- ══ ROLE REQUEST ══ -->
                <VBox fx:id="roleRequestSection" spacing="10" visible="false" managed="false"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-padding: 14 16;">
                    <Label text="ROLE REQUEST" style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelRoleRequestStatus" text="" style="-fx-font-size: 12px;" wrapText="true"/>
                    <Button text="Manage role request" onAction="#goToRoleRequest"
                            style="-fx-background-color: transparent; -fx-border-color: #534AB7; -fx-border-width: 0.5; -fx-border-radius: 8; -fx-text-fill: #534AB7; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 14;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent transparent transparent #e1e3ef; -fx-border-width: 0 0 0 1;"
              minWidth="260" maxWidth="260" spacing="12">
            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>

            <!-- Profile card -->
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;"
                  spacing="10" alignment="CENTER">
                <StackPane>
                    <Circle fx:id="avatarCircleRight" radius="30" fill="#EEEDFE" style="-fx-stroke: #534AB7; -fx-stroke-width: 2;"/>
                    <Label fx:id="avatarInitialsRight" text="?" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3C3489;"/>
                    <ImageView fx:id="avatarImageRight" fitWidth="60" fitHeight="60" preserveRatio="false" visible="false"/>
                </StackPane>
                <Label fx:id="labelProfileName" text="Loading..." style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                <Label fx:id="labelProfileEmail" text="" style="-fx-font-size: 11px; -fx-text-fill: #6d748a;"/>
                <Label fx:id="labelProfileRole" text="" style="-fx-background-color: #EEEDFE; -fx-text-fill: #534AB7; -fx-background-radius: 10; -fx-padding: 2 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <Button onAction="#goToEditProfile" text="Edit Profile"
                        style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 7 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Shortcuts -->
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Shortcuts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button onAction="#goToDashboard" text="🏠 Dashboard"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 228;"/>
                    <Button onAction="#goToSocialHub" text="🌐 Social Hub"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 228;"/>
                    <Button onAction="#goToEmotions" text="🧠 Mental Health"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 228;"/>
                    <Button onAction="#goToAvatarBuilder" text="🎨 Avatar Builder"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 228;"/>
                    <Button onAction="#goToRoleRequest" text="📋 Role Request"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 228;"/>
                </VBox>
            </VBox>

        </VBox>
    </right>

</BorderPane>
