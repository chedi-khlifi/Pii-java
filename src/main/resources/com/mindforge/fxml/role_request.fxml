<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.architect.controller.RoleRequestController"
            style="-fx-background-color: #ececf2; -fx-border-color: transparent; -fx-background: #ececf2;">

    <VBox spacing="14" style="-fx-padding: 24 28 32 28;">

        <!-- ══ HEADER ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 6 0;">
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-border-color: #cccccc;
                           -fx-border-radius: 8; -fx-border-width: 0.5;
                           -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
            <Label text="Role Request"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </HBox>

        <!-- ══ EXISTING REQUEST STATUS ═══════════════════════════════════ -->
        <VBox fx:id="existingRequestSection" spacing="8" visible="false" managed="false"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e0e0e0; -fx-border-width: 0.5;
                     -fx-border-radius: 12; -fx-padding: 16 18;">
            <Label text="CURRENT REQUEST"
                   style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa; -fx-font-weight: bold;"/>
            <Label fx:id="labelStatus" text=""
                   style="-fx-font-size: 14px;"/>
            <Label fx:id="labelAdminNotes" text=""
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
        </VBox>

        <!-- ══ SUBMISSION FORM ═══════════════════════════════════════════ -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e0e0e0; -fx-border-width: 0.5;
                     -fx-border-radius: 12; -fx-padding: 20 22;">

            <Label text="REQUEST ROLE UPGRADE"
                   style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa; -fx-font-weight: bold;"/>

            <Label text="Explain why you need an upgraded role (teacher, company, etc). An admin will review your request."
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #555555; -fx-line-spacing: 2;"/>

            <VBox spacing="4">
                <Label text="Your motivation (min. 20 characters)"
                       style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                <TextArea fx:id="fieldMotivation"
                          promptText="I would like to request a role upgrade because..."
                          prefRowCount="6"
                          wrapText="true"
                          style="-fx-font-size: 13px; -fx-padding: 8 10;
                                 -fx-background-radius: 8; -fx-border-radius: 8;
                                 -fx-border-color: #e0e0e0; -fx-border-width: 0.5;"/>
            </VBox>

            <Label fx:id="labelMessage" text=""
                   wrapText="true" style="-fx-font-size: 13px;"/>

            <Button fx:id="btnSubmit" text="Submit Request" onAction="#handleSubmit"
                    style="-fx-background-color: #534AB7; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-font-size: 13px;
                           -fx-cursor: hand; -fx-padding: 9 20;"/>
        </VBox>

    </VBox>
</ScrollPane>
