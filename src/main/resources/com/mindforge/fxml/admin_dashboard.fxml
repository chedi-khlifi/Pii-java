<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.controller.AdminDashboardController"
            style="-fx-background-color: #f8f9fa;">

    <!-- Top Navigation -->
    <top>
        <HBox style="-fx-background-color: #0f172a; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);"
              alignment="CENTER_LEFT" spacing="15" minHeight="56">
            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <Label text="🔥 MindForge Admin" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 700; -fx-font-family: 'Space Grotesk', sans-serif;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search -->
            <TextField fx:id="searchField" promptText="🔍 Search users..."
                       style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8;
                              -fx-background-radius: 8; -fx-padding: 8 12; -fx-min-width: 250;"/>

            <!-- Profile -->
            <Button onAction="#goToProfile" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="👤" style="-fx-font-size: 16px;"/>
                        <Label fx:id="adminNameLabel" text="Admin" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    </HBox>
                </graphic>
            </Button>

            <Button onAction="#logout" text="Logout"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 8;
                           -fx-padding: 8 16; -fx-cursor: hand; -fx-font-weight: 600;"/>
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox style="-fx-background-color: white; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="250" maxWidth="250" spacing="5">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="CORE" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 700; -fx-padding: 0 0 10 10;"/>

            <Button text="📊 Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: 600;
                           -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-min-width: 220;"/>

            <Button text="👥 Users" onAction="#showUsers"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: 600;
                           -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-min-width: 220;"/>

            <Button text="🎓 Students"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: 600;
                           -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-min-width: 220;"/>

            <Button text="💼 Careers"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: 600;
                           -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-min-width: 220;"/>

            <Region minHeight="20"/>

            <Label text="SYSTEM" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: 700; -fx-padding: 0 0 10 10;"/>

            <Button text="⚙️ Settings"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: 600;
                           -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-min-width: 220;"/>

            <Button text="📝 Logs"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: 600;
                           -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-min-width: 220;"/>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20">
                <padding>
                    <Insets top="24" right="28" bottom="24" left="28"/>
                </padding>

                <!-- Hero Card -->
                <VBox style="-fx-background-color: linear-gradient(to right, #ffffff, #eef6ff);
                            -fx-background-radius: 20; -fx-padding: 24 28;
                            -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.12), 35, 0, 0, 18);
                            -fx-border-color: rgba(15,23,42,0.06); -fx-border-radius: 20; -fx-border-width: 1;">
                    <Label text="User Management" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #0f172a; -fx-font-family: 'Space Grotesk', sans-serif;"/>
                    <Label text="Manage all users, roles, and permissions from one place."
                           style="-fx-font-size: 14px; -fx-text-fill: #64748b; -fx-padding: 4 0 0 0;"/>
                </VBox>

                <!-- Stats Cards -->
                <HBox spacing="16">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 18;
                                -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 30, 0, 0, 16);
                                -fx-border-color: rgba(15,23,42,0.08); -fx-border-radius: 18; -fx-border-width: 1;
                                -fx-padding: 20; -fx-min-width: 200;" spacing="8">
                        <Label text="TOTAL USERS" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <Label fx:id="totalUsersLabel" text="0" style="-fx-text-fill: #0f172a; -fx-font-size: 32px; -fx-font-weight: 700;"/>
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 18;
                                -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 30, 0, 0, 16);
                                -fx-border-color: rgba(15,23,42,0.08); -fx-border-radius: 18; -fx-border-width: 1;
                                -fx-padding: 20; -fx-min-width: 200;" spacing="8">
                        <Label text="ADMINS" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <Label fx:id="adminCountLabel" text="0" style="-fx-text-fill: #dc2626; -fx-font-size: 32px; -fx-font-weight: 700;"/>
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 18;
                                -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 30, 0, 0, 16);
                                -fx-border-color: rgba(15,23,42,0.08); -fx-border-radius: 18; -fx-border-width: 1;
                                -fx-padding: 20; -fx-min-width: 200;" spacing="8">
                        <Label text="VERIFIED" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <Label fx:id="verifiedCountLabel" text="0" style="-fx-text-fill: #16a34a; -fx-font-size: 32px; -fx-font-weight: 700;"/>
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 18;
                                -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 30, 0, 0, 16);
                                -fx-border-color: rgba(15,23,42,0.08); -fx-border-radius: 18; -fx-border-width: 1;
                                -fx-padding: 20; -fx-min-width: 200;" spacing="8">
                        <Label text="NEW TODAY" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <Label fx:id="newTodayLabel" text="0" style="-fx-text-fill: #4f46e5; -fx-font-size: 32px; -fx-font-weight: 700;"/>
                    </VBox>
                </HBox>

                <!-- Filters -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="filterEmail" promptText="🔍 Search by email or ID..."
                               style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8;
                                      -fx-background-radius: 8; -fx-padding: 10 14; -fx-min-width: 250;"/>

                    <ComboBox fx:id="roleFilter" promptText="All Roles"
                              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-padding: 4 8; -fx-min-width: 150;"/>

                    <ComboBox fx:id="verifiedFilter" promptText="All Status"
                              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-padding: 4 8; -fx-min-width: 150;"/>

                    <Button text="Clear Filters" onAction="#clearFilters"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: 600;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="➕ Add User" onAction="#showAddUserDialog"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: 600;"/>
                </HBox>

                <!-- Users Table -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 18;
                            -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 30, 0, 0, 16);
                            -fx-border-color: rgba(15,23,42,0.08); -fx-border-radius: 18; -fx-border-width: 1;">

                    <TableView fx:id="usersTable" style="-fx-background-radius: 18; -fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                            <TableColumn fx:id="colRoles" text="Roles" prefWidth="150"/>
                            <TableColumn fx:id="colVerified" text="Verified" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colCreated" text="Created At" prefWidth="150"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="200" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <Label text="No users found" style="-fx-text-fill: #94a3b8; -fx-padding: 40;"/>
                        </placeholder>
                    </TableView>

                </VBox>

                <!-- Result Count -->
                <Label fx:id="resultCountLabel" text="Showing 0 user(s)"
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>