<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane fx:id="mainContainer"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindforge.architect.controller.SocialHubController"
            style="-fx-background-color: #ececf2;">

    <!-- ══ TOP HEADER ═══════════════════════════════════════════════ -->
    <top>
        <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 0.5 0;">
            <!-- Title bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 14 20 10 20;">
                <Button fx:id="btnBackToProfile" text="← Profile" onAction="#onBackToProfile"
                        style="-fx-background-color: transparent; -fx-text-fill: #534AB7; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 4 10;"/>
                <Label fx:id="headerTitle" text="Social Hub"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Notification badge -->
                <StackPane>
                    <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-cursor: hand;"/>
                    <Label fx:id="notificationBadge" text="0" visible="false" managed="false"
                           style="-fx-background-color: #E53935; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 1 6; -fx-font-size: 10px; -fx-font-weight: bold;"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>
            </HBox>

            <!-- Tab bar -->
            <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 0 20 12 20;">
                <Button fx:id="btnDiscover" text="Discover" onAction="#onDiscover"
                        style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button fx:id="btnFriends" text="Friends" onAction="#onFriends"
                        style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-background-radius: 10; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button fx:id="btnPending" text="Pending" onAction="#onPending"
                        style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-background-radius: 10; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button fx:id="btnMessages" text="Messages" onAction="#onMessages"
                        style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-background-radius: 10; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Search by name or email..."
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #e0e0e0; -fx-border-width: 0.5; -fx-padding: 6 14; -fx-font-size: 12px; -fx-pref-width: 220;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ══ CENTER CONTENT ═════════════════════════════════════════ -->
    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true"
                    style="-fx-background: #ececf2; -fx-border-color: transparent; -fx-background-color: #ececf2;">
            <VBox fx:id="contentBox" spacing="12" style="-fx-padding: 16 20 24 20;"/>
        </ScrollPane>
    </center>

</BorderPane>
