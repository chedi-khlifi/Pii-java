<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mindforge.controller.RegisterController"
           style="-fx-background-color: linear-gradient(to right, #1e1e2e, #2b2b45);">

    <HBox alignment="CENTER">

        <!-- LEFT SIDE -->
        <VBox alignment="CENTER"
              spacing="15"
              HBox.hgrow="ALWAYS"
              style="-fx-padding: 60;">

            <Label text="MindForge"
                   style="-fx-text-fill: white;
                          -fx-font-size: 42px;
                          -fx-font-weight: bold;"/>

            <Label text="Join the future of secure systems"
                   style="-fx-text-fill: #aaaaaa;
                          -fx-font-size: 16px;"/>

        </VBox>

        <!-- RIGHT SIDE CARD -->
        <StackPane HBox.hgrow="ALWAYS" alignment="CENTER">

            <VBox spacing="14"
                  alignment="CENTER"
                  maxWidth="380"
                  style="-fx-background-color: rgba(46,46,62,0.92);
                         -fx-background-radius: 16;
                         -fx-padding: 30;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20,0,0,10);">

                <Label text="Create Account"
                       style="-fx-text-fill: white;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;"/>

                <!-- EMAIL -->
                <TextField fx:id="emailField"
                           promptText="Email"
                           maxWidth="Infinity"
                           style="-fx-background-color: #2e2e3e;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #777;
                                  -fx-background-radius: 8;
                                  -fx-padding: 12;"/>

                <!-- PASSWORD -->
                <PasswordField fx:id="passwordField"
                               promptText="Password"
                               maxWidth="Infinity"
                               style="-fx-background-color: #2e2e3e;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #777;
                                      -fx-background-radius: 8;
                                      -fx-padding: 12;"/>

                <!-- CONFIRM PASSWORD -->
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirm Password"
                               maxWidth="Infinity"
                               style="-fx-background-color: #2e2e3e;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #777;
                                      -fx-background-radius: 8;
                                      -fx-padding: 12;"/>

                <!-- MESSAGE -->
                <Label fx:id="messageLabel"
                       wrapText="true"
                       style="-fx-text-fill: #ff6b6b;
                              -fx-font-size: 13px;"/>

                <!-- REGISTER BUTTON -->
                <Button text="Register"
                        onAction="#handleRegister"
                        maxWidth="Infinity"
                        style="-fx-background-color: #7c3aed;
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 12;"/>

                <!-- DIVIDER -->
                <HBox alignment="CENTER" spacing="10">
                    <Region style="-fx-background-color: #555; -fx-min-height: 1; -fx-pref-width: 100;"/>
                    <Label text="OR" style="-fx-text-fill: #888; -fx-font-size: 12px;"/>
                    <Region style="-fx-background-color: #555; -fx-min-height: 1; -fx-pref-width: 100;"/>
                </HBox>

                <!-- GOOGLE -->
                <Button fx:id="googleButton"
                        onAction="#handleGoogleRegister"
                        maxWidth="Infinity"
                        style="-fx-background-color: white;
                               -fx-text-fill: #444;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 12;
                               -fx-border-color: #ddd;
                               -fx-border-radius: 10;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER">
                            <Label text="🔍" style="-fx-font-size: 16px;"/>
                            <Label text="Sign up with Google"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- LOGIN LINK -->
                <Button text="Already have an account? Login"
                        onAction="#goToLogin"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #7c3aed;
                               -fx-border-color: #7c3aed;
                               -fx-border-radius: 10;
                               -fx-background-radius: 10;
                               -fx-padding: 10;"/>

            </VBox>

        </StackPane>

    </HBox>

</StackPane>