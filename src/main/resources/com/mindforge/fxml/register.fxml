<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindforge.architect.controller.RegisterController"
      minWidth="900" minHeight="600"
      style="-fx-background-color: #0f0f1a;">

    <!-- ══════════════════════════════════════════════════════════
         LEFT PANEL — brand + benefits
    ══════════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS"
          alignment="CENTER_LEFT"
          spacing="0"
          style="-fx-background-color: linear-gradient(to bottom right, #1a1040, #2d1b6e, #1e1e3a);
                 -fx-min-width: 420; -fx-max-width: 560;">
        <padding><Insets top="60" right="56" bottom="60" left="56"/></padding>

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🔥" style="-fx-font-size: 32px;"/>
            <Label text="MindForge"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>

        <Region minHeight="40"/>

        <!-- Headline -->
        <Label text="Start your journey today."
               wrapText="true"
               style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: white;
                      -fx-line-spacing: 4;"/>
        <Label text="Free. Powerful. Yours."
               style="-fx-font-size: 18px; -fx-text-fill: #c4b5fd; -fx-padding: 10 0 0 0;"/>

        <Region minHeight="48"/>

        <!-- Benefit bullets -->
        <VBox spacing="18">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="🧠" style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="Mental Health Check"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="AI detects your mood and gives personalised wellness insights."
                           wrapText="true" maxWidth="320"
                           style="-fx-font-size: 12px; -fx-text-fill: #a5b4fc;"/>
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="📅" style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="Planner &amp; Focus Timer"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Organise tasks, track exams and stay in deep focus."
                           wrapText="true" maxWidth="320"
                           style="-fx-font-size: 12px; -fx-text-fill: #a5b4fc;"/>
                </VBox>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="🚀" style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="Career Opportunities"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Browse companies, apply for jobs and grow your network."
                           wrapText="true" maxWidth="320"
                           style="-fx-font-size: 12px; -fx-text-fill: #a5b4fc;"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="Join thousands of students and professionals."
               style="-fx-font-size: 11px; -fx-text-fill: #6d6d8a;"/>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         RIGHT PANEL — register form
    ══════════════════════════════════════════════════════════ -->
    <StackPane HBox.hgrow="ALWAYS"
               alignment="CENTER"
               style="-fx-background-color: #f5f5fa;">

        <VBox spacing="0"
              alignment="TOP_CENTER"
              maxWidth="420" minWidth="340"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 30, 0, 0, 8);">
            <padding><Insets top="40" right="44" bottom="40" left="44"/></padding>

            <!-- Form header -->
            <Label text="Create your account ✨"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
            <Label text="It's free and takes less than a minute"
                   style="-fx-font-size: 13px; -fx-text-fill: #6d748a; -fx-padding: 6 0 24 0;"/>

            <!-- Email -->
            <Label text="Email address"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 0 0 6 0;"/>
            <TextField fx:id="emailField"
                       promptText="you@example.com"
                       maxWidth="Infinity"
                       style="-fx-background-color: #f9fafb;
                              -fx-border-color: #e1e3ef;
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 12 14; -fx-font-size: 14px;
                              -fx-text-fill: #21273b; -fx-prompt-text-fill: #9ca3af;"/>

            <!-- Password -->
            <Label text="Password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 16 0 6 0;"/>
            <PasswordField fx:id="passwordField"
                           promptText="At least 6 characters"
                           maxWidth="Infinity"
                           style="-fx-background-color: #f9fafb;
                                  -fx-border-color: #e1e3ef;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 12 14; -fx-font-size: 14px;
                                  -fx-text-fill: #21273b; -fx-prompt-text-fill: #9ca3af;"/>

            <!-- Confirm Password -->
            <Label text="Confirm password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 16 0 6 0;"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Repeat your password"
                           maxWidth="Infinity"
                           style="-fx-background-color: #f9fafb;
                                  -fx-border-color: #e1e3ef;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 12 14; -fx-font-size: 14px;
                                  -fx-text-fill: #21273b; -fx-prompt-text-fill: #9ca3af;"/>

            <!-- Message label -->
            <Label fx:id="messageLabel" text=""
                   wrapText="true" maxWidth="Infinity"
                   style="-fx-font-size: 12px; -fx-padding: 10 0 0 0;"/>

            <!-- Register button -->
            <Button text="Create Account"
                    onAction="#handleRegister"
                    maxWidth="Infinity"
                    style="-fx-background-color: #534AB7;
                           -fx-text-fill: white;
                           -fx-font-size: 15px; -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 13 0;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(83,74,183,0.35), 12, 0, 0, 4);">
                <VBox.margin><Insets top="18"/></VBox.margin>
            </Button>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 18 0;">
                <Line endX="110" stroke="#e1e3ef" strokeWidth="1"/>
                <Label text="or" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                <Line endX="110" stroke="#e1e3ef" strokeWidth="1"/>
            </HBox>

            <!-- Google button -->
            <Button fx:id="googleButton"
                    onAction="#handleGoogleRegister"
                    maxWidth="Infinity"
                    style="-fx-background-color: white;
                           -fx-border-color: #e1e3ef; -fx-border-radius: 10;
                           -fx-background-radius: 10;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-text-fill: #374151;
                           -fx-padding: 12 0; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="G" style="-fx-font-size: 16px; -fx-font-weight: bold;
                                               -fx-text-fill: #4285F4;"/>
                        <Label text="Continue with Google"
                               style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Login link -->
            <Button text="Already have an account? Sign in"
                    onAction="#goToLogin"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #534AB7;
                           -fx-border-color: #534AB7;
                           -fx-border-radius: 10; -fx-background-radius: 10;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 12 0; -fx-cursor: hand;">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Button>

        </VBox>
    </StackPane>

</HBox>
