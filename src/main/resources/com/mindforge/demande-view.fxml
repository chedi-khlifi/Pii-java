<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindforge.controllers.carriere.DemandeController"
      spacing="16" style="-fx-padding: 32; -fx-background-color: #f7f8fc;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox>
            <Label text="Demandes" styleClass="page-title"/>
            <Label text="Manage career applications" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Add" styleClass="btn-primary" onAction="#showAddForm"/>
        <Button text="Edit" styleClass="btn-success" onAction="#showEditForm"/>
        <Button text="Delete" styleClass="btn-danger" onAction="#deleteSelected"/>
    </HBox>

    <!-- Table -->
    <VBox styleClass="table-wrapper" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                <TableColumn fx:id="colOpportunity" text="Opportunity" prefWidth="230"/>
                <TableColumn fx:id="colUserId" text="User ID" prefWidth="90"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                <TableColumn fx:id="colAppliedAt" text="Applied At" prefWidth="160"/>
            </columns>
            <placeholder><Label text="No applications found. Click Add to create one."/></placeholder>
        </TableView>
    </VBox>

    <!-- Form Panel -->
    <VBox fx:id="formPanel" styleClass="form-panel" spacing="14" visible="false" managed="false">
        <Label fx:id="formTitle" text="Add Demande" styleClass="section-title"/>

        <GridPane hgap="20" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="110"/>
                <ColumnConstraints prefWidth="260" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="110" prefWidth="110"/>
                <ColumnConstraints prefWidth="260" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Opportunity *" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="fieldOpportunity" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="User ID *" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="fieldUserId" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Status" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="fieldStatus" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Cover Letter *" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextArea fx:id="fieldCoverLetter" prefHeight="90" wrapText="true"
                      GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>
        </GridPane>

        <HBox spacing="10">
            <Button text="Save" styleClass="btn-primary" onAction="#saveEntity"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#cancelForm"/>
        </HBox>
    </VBox>

</VBox>
