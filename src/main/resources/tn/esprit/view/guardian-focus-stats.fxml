<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="tn.esprit.GuardianController" styleClass="guardian-root" stylesheets="@guardian-cards.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox spacing="12" styleClass="guardian-sidebar">
            <padding><Insets top="18" right="14" bottom="18" left="14" /></padding>
            <HBox spacing="6"><Label text="◉" styleClass="guardian-brand-mark" /><Label text="MindForge" styleClass="guardian-brand" /></HBox>
            <Button text="▣ Planner" onAction="#onOpenPlanner" styleClass="guardian-global-nav-button" />
            <Button text="◈ Community" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Button text="▤ Guardian" onAction="#onGoHub" styleClass="guardian-global-nav-button,guardian-global-nav-selected" />
            <Button text="▦ Careers" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Button text="◔ Analyst" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Label text="QUICK LINKS" styleClass="guardian-side-group-title" />
            <Button text="Contact Support" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link" />
            <Button text="Friends" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link" />
            <Button text="Leaderboard" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link" />
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="guardian-main-scroll">
            <content>
                <VBox spacing="14" styleClass="guardian-page-wrap">
                    <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>

                    <VBox spacing="5" styleClass="guardian-hero,guardian-hero-focus">
                        <padding><Insets top="20" right="24" bottom="20" left="24" /></padding>
                        <Label text="Focus Stats" styleClass="guardian-hero-title" />
                        <Label text="Track total focus minutes and top tasks." styleClass="guardian-hero-subtitle" />
                    </VBox>

                    <HBox spacing="8">
                        <Button text="Focus Timer" onAction="#onGoFocus" styleClass="guardian-tab-button" />
                        <Button text="Focus Stats" onAction="#onGoFocusStats" styleClass="guardian-tab-button,guardian-tab-selected" />
                        <Button text="Virtual Rooms" onAction="#onGoRooms" styleClass="guardian-tab-button" />
                        <Button text="Resource Library" onAction="#onGoLibrary" styleClass="guardian-tab-button" />
                    </HBox>

                    <Label fx:id="moduleSnapshotLabel" text="Loading snapshot..." styleClass="guardian-snapshot" />

                    <VBox spacing="10" styleClass="guardian-panel">
                        <Label text="Summary" styleClass="guardian-section-title" />
                        <FlowPane fx:id="focusUserStatsCards" hgap="10" vgap="10" prefWrapLength="950" styleClass="guardian-cards-flow" />
                    </VBox>

                    <VBox spacing="10" styleClass="guardian-panel">
                        <Label text="Recent Focus Sessions" styleClass="guardian-section-title" />
                        <ScrollPane fitToWidth="true" prefViewportHeight="360" styleClass="guardian-card-scroll">
                            <content>
                                <FlowPane fx:id="focusCards" hgap="12" vgap="12" prefWrapLength="980" styleClass="guardian-cards-flow" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <right>
        <VBox spacing="12" styleClass="guardian-rightbar">
            <padding><Insets top="16" right="14" bottom="16" left="14" /></padding>
            <VBox spacing="8" styleClass="guardian-side-card">
                <Label text="Network" styleClass="guardian-side-title" />
                <Button text="Workspace Network Hub" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
                <Button text="Workspace Home" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
                <Button text="Friends Directory" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
            </VBox>
            <VBox spacing="8" styleClass="guardian-side-card">
                <Label text="Shortcuts" styleClass="guardian-side-title" />
                <Button text="Focus Timer" onAction="#onGoFocus" styleClass="guardian-side-link" />
                <Button text="Virtual Rooms" onAction="#onGoRooms" styleClass="guardian-side-link" />
                <Button text="Leaderboard" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
            </VBox>
        </VBox>
    </right>
</BorderPane>
