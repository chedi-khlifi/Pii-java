<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="tn.esprit.GuardianController" styleClass="guardian-root" stylesheets="@guardian-cards.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox spacing="12" styleClass="guardian-sidebar">
            <padding><Insets top="18" right="14" bottom="18" left="14" /></padding>
            <HBox spacing="6"><Label text="◉" styleClass="guardian-brand-mark" /><Label text="MindForge" styleClass="guardian-brand" /></HBox>
            <Button text="▣ Planner" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Button text="◈ Community" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Button text="▤ Guardian" onAction="#onGoHub" styleClass="guardian-global-nav-button,guardian-global-nav-selected" />
            <Button text="▦ Careers" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Button text="◔ Analyst" onAction="#onIntegrationPlaceholder" styleClass="guardian-global-nav-button" />
            <Label text="QUICK LINKS" styleClass="guardian-side-group-title" />
            <Button text="Contact Support" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link" />
            <Button text="Friends" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link" />
            <Button text="Leaderboard" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link" />
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="guardian-main-scroll">
            <content>
                <VBox spacing="14" styleClass="guardian-page-wrap">
                    <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>

                    <VBox spacing="5" styleClass="guardian-hero,guardian-hero-library">
                        <padding><Insets top="20" right="24" bottom="20" left="24" /></padding>
                        <Label text="Resource Library" styleClass="guardian-hero-title" />
                        <Label text="Manage files and curated learning content with fast filtering." styleClass="guardian-hero-subtitle" />
                    </VBox>

                    <HBox spacing="8">
                        <Button text="Focus Timer" onAction="#onGoFocus" styleClass="guardian-tab-button" />
                        <Button text="Virtual Rooms" onAction="#onGoRooms" styleClass="guardian-tab-button" />
                        <Button text="Resource Library" onAction="#onGoLibrary" styleClass="guardian-tab-button,guardian-tab-selected" />
                    </HBox>

                    <Label fx:id="moduleSnapshotLabel" text="Loading snapshot..." styleClass="guardian-snapshot" />

                    <VBox spacing="10" styleClass="guardian-panel">
                        <Label text="Add / Update Resource" styleClass="guardian-section-title" />
                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Resource ID (auto)" styleClass="guardian-input-label" /><TextField fx:id="libraryIdField" editable="false" /></VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Title" styleClass="guardian-input-label" /><TextField fx:id="libraryTitleField" /></VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Description" styleClass="guardian-input-label" /><TextField fx:id="libraryDescriptionField" /></VBox>
                        </HBox>
                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="File path" styleClass="guardian-input-label" /><TextField fx:id="libraryFilePathField" /></VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Type" styleClass="guardian-input-label" /><ComboBox fx:id="libraryTypeField" maxWidth="Infinity" /></VBox>
                        </HBox>
                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Subject ID" styleClass="guardian-input-label" /><TextField fx:id="librarySubjectIdField" /></VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Uploader ID" styleClass="guardian-input-label" /><TextField fx:id="libraryUploaderIdField" /></VBox>
                        </HBox>
                        <HBox spacing="8">
                            <Button text="Add resource" onAction="#onLibraryCreate" styleClass="guardian-action-primary" />
                            <Button text="Update" onAction="#onLibraryUpdate" styleClass="guardian-action-secondary" />
                            <Button text="Delete" onAction="#onLibraryDelete" styleClass="guardian-action-danger" />
                            <Button text="Refresh" onAction="#onLibraryRefresh" styleClass="guardian-action-secondary" />
                            <Button text="Filter by subject/type" onAction="#onIntegrationPlaceholder" styleClass="guardian-action-success" />
                            <Button text="Search" onAction="#onIntegrationPlaceholder" styleClass="guardian-action-ghost" />
                        </HBox>
                    </VBox>

                    <VBox spacing="10" styleClass="guardian-panel">
                        <Label text="External suggestions &amp; Cloud Storage" styleClass="guardian-section-title" />
                        <HBox spacing="8">
                            <Button text="AI Suggested Links" onAction="#onAiSuggestedLinks" styleClass="guardian-action-secondary" />
                            <Button text="Trending Resources" onAction="#onTrendingResources" styleClass="guardian-action-secondary" />
                            <Button text="Import from Drive" onAction="#onImportFromDrive" styleClass="guardian-action-primary" />
                            <Button text="Sync Dropbox Folder" onAction="#onSyncDropboxFolder" styleClass="guardian-action-secondary" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="libraryMessageContainer" spacing="5" />
                    <Label fx:id="libraryMessageLabel" text="" wrapText="true" styleClass="guardian-message,guardian-message-muted" />
                    <ScrollPane fitToWidth="true" prefViewportHeight="420" styleClass="guardian-card-scroll">
                        <content>
                            <FlowPane fx:id="libraryCards" hgap="12" vgap="12" prefWrapLength="980" styleClass="guardian-cards-flow" />
                        </content>
                    </ScrollPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <right>
        <VBox spacing="12" styleClass="guardian-rightbar">
            <padding><Insets top="16" right="14" bottom="16" left="14" /></padding>
            <VBox spacing="8" styleClass="guardian-side-card">
                <Label text="Network" styleClass="guardian-side-title" />
                <Button text="Workspace Network Hub" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
                <Button text="Workspace Home" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
                <Button text="Friends Directory" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
            </VBox>
            <VBox spacing="8" styleClass="guardian-side-card">
                <Label text="Shortcuts" styleClass="guardian-side-title" />
                <Button text="Focus Timer" onAction="#onGoFocus" styleClass="guardian-side-link" />
                <Button text="Virtual Rooms" onAction="#onGoRooms" styleClass="guardian-side-link" />
                <Button text="Leaderboard" onAction="#onIntegrationPlaceholder" styleClass="guardian-side-link" />
            </VBox>
        </VBox>
    </right>
</BorderPane>
