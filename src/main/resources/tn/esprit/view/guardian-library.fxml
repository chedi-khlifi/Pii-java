<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="tn.esprit.GuardianController"
            style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: transparent #e5e7eb transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="200" maxWidth="200" spacing="4">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

            <!-- Brand -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 16 4;">
                <Label text="🔥" style="-fx-font-size: 16px;"/>
                <Label text="MindForge" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
            </HBox>

            <!-- Nav items -->
            <Button text="📁  Planner"   onAction="#onOpenPlanner"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="👥  Community" onAction="#onOpenCommunity"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="📚  Guardian"  onAction="#onGoHub"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="💼  Careers"   onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="📊  Analyst"   onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>

            <Region minHeight="16"/>
            <Label text="QUICK LINKS" style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 0 0 4 4;"/>
            <Button text="Contact Support" onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 6 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="Friends"         onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 6 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="Leaderboard"     onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 6 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5; -fx-border-color: transparent;">
            <content>
                <VBox spacing="16" style="-fx-background-color: #f0f2f5; -fx-padding: 16 20 24 20;">

                    <!-- Gradient hero banner — pink→purple→teal -->
                    <VBox style="-fx-background-color: linear-gradient(to right, #ec4899, #8b5cf6 50%, #06b6d4); -fx-background-radius: 12;" spacing="4">
                        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                        <Label text="Guardian Library"
                               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Browse and manage learning resources."
                               style="-fx-text-fill: white; -fx-opacity: 0.9; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Intro card — white rounded panel -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 20 20 20 20;" spacing="8">
                        <Label text="📚 Popular resources"
                               style="-fx-background-color: #ede9fe; -fx-text-fill: #7c3aed; -fx-background-radius: 20; -fx-padding: 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label text="Resource Library"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Browse a curated collection of shared learning resources."
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    </VBox>

                    <!-- Filter panel — Subject / Type / Search -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 20;" spacing="14">
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Subject" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <ComboBox fx:id="librarySubjectFilter" promptText="-- All subjects --" maxWidth="Infinity"
                                          style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Type" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <ComboBox fx:id="libraryFilterTypeField" promptText="-- All types --" maxWidth="Infinity"
                                          style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Search" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <TextField fx:id="librarySearchField" promptText="Search..."
                                           style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 10;"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="10">
                            <Button text="Filter" onAction="#onLibraryApplyFilters"
                                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9 24; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="Reset"  onAction="#onLibraryClearFilters"
                                    style="-fx-background-color: white; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 24; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <Label fx:id="libraryMessageLabel" text="" wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>

                    <!-- Resource cards -->
                    <FlowPane fx:id="libraryCards" hgap="16" vgap="16" prefWrapLength="900"/>

                    <!-- External Suggestions -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 20;" spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="External Suggestions (Open Library)"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="↺ Refresh" onAction="#onAiSuggestedLinks"
                                    style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 5 12; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </HBox>
                        <Label fx:id="externalSuggestionsLabel" text="Query: study skills"
                               style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                        <FlowPane fx:id="externalSuggestionsCards" hgap="12" vgap="12" prefWrapLength="900"/>
                    </VBox>

                    <!-- Hidden controller fields -->
                    <VBox fx:id="libraryMessageContainer" spacing="0" managed="false" visible="false"/>
                    <TextField fx:id="libraryIdField"          managed="false" visible="false"/>
                    <TextField fx:id="libraryTitleField"       managed="false" visible="false"/>
                    <TextField fx:id="libraryDescriptionField" managed="false" visible="false"/>
                    <TextField fx:id="libraryFilePathField"    managed="false" visible="false"/>
                    <TextField fx:id="libraryRatingField"      managed="false" visible="false"/>
                    <ComboBox  fx:id="libraryTypeField"        managed="false" visible="false"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: transparent transparent transparent #e5e7eb; -fx-border-width: 0 0 0 1;"
              minWidth="220" maxWidth="220" spacing="20">
            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

            <!-- Network -->
            <VBox spacing="8">
                <Label text="Network" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Button text="Workspace Network Hub" onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Workspace Home"        onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Friends Directory"     onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
            </VBox>

            <Region style="-fx-background-color: #e5e7eb; -fx-pref-height: 1; -fx-max-height: 1;"/>

            <!-- Shortcuts -->
            <VBox spacing="8">
                <Label text="Shortcuts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Button text="Focus Timer"   onAction="#onGoFocus"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Virtual Rooms" onAction="#onGoRooms"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Leaderboard"   onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
            </VBox>

        </VBox>
    </right>

</BorderPane>
