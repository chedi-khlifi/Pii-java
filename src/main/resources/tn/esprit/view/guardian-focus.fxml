<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="tn.esprit.GuardianController"
            stylesheets="@guardian-cards.css"
            style="-fx-background-color: #f5f5fa;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent #e1e3ef transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="210" maxWidth="210" spacing="5">
            <padding><Insets top="14" right="12" bottom="14" left="12"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="8" right="10" bottom="10" left="10"/></padding>
                <Label text="🔥" style="-fx-font-size: 20px;"/>
                <Label text="MindForge" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #21273b;"/>
            </HBox>

            <VBox spacing="5">
                <Button text="📁  Planner"   onAction="#onOpenPlanner"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="👥  Community" onAction="#onOpenCommunity"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📚  Guardian"  onAction="#onGoHub"
                        style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="💼  Careers"   onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
                <Button text="📊  Analyst"   onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #6d748a; -fx-font-weight: 600; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            </VBox>

            <Region minHeight="20"/>

            <Label text="QUICK LINKS" style="-fx-text-fill: #a0a5b8; -fx-font-weight: 700; -fx-font-size: 11px;">
                <padding><Insets bottom="6" left="8" right="8" top="0"/></padding>
            </Label>
            <Button text="Contact Support" onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6a7186; -fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            <Button text="Friends"         onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6a7186; -fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
            <Button text="Leaderboard"     onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6a7186; -fx-font-size: 13px; -fx-padding: 7 10; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 180;"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="guardian-main-scroll">
            <content>
                <VBox spacing="14" style="-fx-background-color: #f5f5fa;">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <!-- Gradient hero banner -->
                    <VBox spacing="5" styleClass="guardian-hero guardian-hero-focus">
                        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                        <Label text="Focus Timer" styleClass="guardian-hero-title"/>
                        <Label text="Run Pomodoro sessions linked to your tasks." styleClass="guardian-hero-subtitle"/>
                    </VBox>

                    <!-- Tab bar -->
                    <HBox spacing="8">
                        <Button text="Focus Timer"      onAction="#onGoFocus"      styleClass="guardian-tab-button guardian-tab-selected"/>
                        <Button text="Focus Stats"      onAction="#onGoFocusStats" styleClass="guardian-tab-button"/>
                        <Button text="Virtual Rooms"    onAction="#onGoRooms"      styleClass="guardian-tab-button"/>
                        <Button text="Resource Library" onAction="#onGoLibrary"    styleClass="guardian-tab-button"/>
                    </HBox>

                    <Label fx:id="moduleSnapshotLabel" text="Guardian module ready." styleClass="guardian-snapshot"/>

                    <!-- ── Pomodoro Timer Card ── -->
                    <VBox spacing="12" styleClass="guardian-panel">

                        <!-- Header row: badge + stats pills -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🍅 Pomodoro"
                                   style="-fx-background-color: #EEEDFE; -fx-text-fill: #534AB7; -fx-background-radius: 20; -fx-padding: 3 10; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="labelTodaySessions" text="Today: 0 sessions"
                                   style="-fx-background-color: #e8f4fd; -fx-text-fill: #1565C0; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px;"/>
                            <Label fx:id="labelWeekMin" text="This week: 0 min"
                                   style="-fx-background-color: #e8f4fd; -fx-text-fill: #1565C0; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px;"/>
                            <Label fx:id="labelTotalMin" text="Total: 0 min"
                                   style="-fx-background-color: #e8f4fd; -fx-text-fill: #1565C0; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px;"/>
                            <Button text="📊 View my stats" onAction="#onGoFocusStats"
                                    style="-fx-background-color: transparent; -fx-text-fill: #534AB7; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 3 8;"/>
                        </HBox>

                        <Label text="Task Focus Sessions"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                        <Label text="Pick a task, start the timer, and save your completed focus session."
                               style="-fx-font-size: 13px; -fx-text-fill: #6d748a;"/>

                        <!-- Task + Duration row -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Task" styleClass="guardian-input-label"/>
                                <ComboBox fx:id="focusTaskField" promptText="-- Select a task --" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Duration (auto by priority)" styleClass="guardian-input-label"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <TextField fx:id="focusDurationField" text="25" prefWidth="80"/>
                                    <Button text="↺" onAction="#onFocusAutoFillDuration"
                                            style="-fx-background-color: #f0f0f0; -fx-background-radius: 6; -fx-padding: 6 10; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="4" alignment="BOTTOM_RIGHT">
                                <Label text=""/>
                                <Button text="Create task" onAction="#onIntegrationPlaceholder"
                                        style="-fx-background-color: transparent; -fx-text-fill: #534AB7; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 10;"/>
                            </VBox>
                        </HBox>

                        <!-- Big timer display -->
                        <StackPane alignment="CENTER" style="-fx-padding: 20 0 10 0;">
                            <VBox alignment="CENTER" spacing="6">
                                <Label fx:id="timerDisplay" text="25:00"
                                       style="-fx-font-size: 52px; -fx-font-weight: bold; -fx-text-fill: #534AB7;"/>
                                <Label fx:id="timerStatus" text="Ready to focus"
                                       style="-fx-font-size: 13px; -fx-text-fill: #6d748a;"/>
                            </VBox>
                        </StackPane>

                        <!-- Timer controls -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button text="▶ Start"        onAction="#onFocusStart"       styleClass="guardian-action-success"/>
                            <Button text="⏸ Pause"        onAction="#onFocusPause"       styleClass="guardian-action-warning"/>
                            <Button text="↺ Reset"        onAction="#onFocusReset"       styleClass="guardian-action-ghost"/>
                            <Button text="💾 Save session" onAction="#onFocusCreate"      styleClass="guardian-action-primary"/>
                        </HBox>

                        <CheckBox fx:id="markDoneOnSave" text="Mark this task as done when saving this session"
                                  style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                    </VBox>

                    <!-- ── AI Focus Tips / Daily Plan / Weekly Review ── -->
                    <VBox spacing="12" styleClass="guardian-panel">
                        <HBox spacing="12">
                            <!-- AI Focus Tips -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8f9ff; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="AI Focus Tips" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="↺ Refresh" onAction="#onAiFocusTips" styleClass="guardian-action-ghost"/>
                                </HBox>
                                <Label fx:id="aiFocusTipsLabel" text="Select a task to load AI tips."
                                       wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                                <HBox spacing="8">
                                    <Button text="👍" onAction="#onIntegrationPlaceholder" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
                                    <Button text="👎" onAction="#onIntegrationPlaceholder" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
                                </HBox>
                            </VBox>

                            <!-- AI Daily Plan -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8f9ff; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="AI Daily Plan" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="↺ Refresh" onAction="#onDailyPlan" styleClass="guardian-action-ghost"/>
                                </HBox>
                                <Label fx:id="aiDailyPlanLabel" text=""
                                       wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                                <HBox spacing="8">
                                    <Button text="👍" onAction="#onIntegrationPlaceholder" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
                                    <Button text="👎" onAction="#onIntegrationPlaceholder" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- AI Weekly Review (full width) -->
                        <VBox spacing="8"
                              style="-fx-background-color: #f8f9ff; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="AI Weekly Review" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="↺ Refresh" onAction="#onWeeklyReview" styleClass="guardian-action-ghost"/>
                            </HBox>
                            <Label fx:id="aiWeeklyReviewLabel" text=""
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;"/>
                            <HBox spacing="8">
                                <Button text="👍" onAction="#onIntegrationPlaceholder" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
                                <Button text="👎" onAction="#onIntegrationPlaceholder" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ── Top Focused Tasks ── -->
                    <VBox spacing="10" styleClass="guardian-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Top Focused Tasks"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="By total minutes"
                                   style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8;"/>
                        </HBox>
                        <FlowPane fx:id="focusUserStatsCards" hgap="10" vgap="10" prefWrapLength="950" styleClass="guardian-cards-flow"/>
                    </VBox>

                    <!-- ── Recent Focus Sessions ── -->
                    <VBox spacing="10" styleClass="guardian-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Recent Focus Sessions"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #21273b;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="sessionCountLabel" text="Latest 12 entries"
                                   style="-fx-font-size: 11px; -fx-text-fill: #a0a5b8;"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" prefViewportHeight="260" styleClass="guardian-card-scroll">
                            <content>
                                <FlowPane fx:id="focusCards" hgap="12" vgap="12" prefWrapLength="980" styleClass="guardian-cards-flow"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox fx:id="focusMessageContainer" spacing="5"/>
                    <Label fx:id="focusMessageLabel" text="" wrapText="true" styleClass="guardian-message guardian-message-muted"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent transparent transparent #e1e3ef; -fx-border-width: 0 0 0 1;"
              minWidth="240" maxWidth="240" spacing="12">
            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>

            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Network" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button text="Workspace Network Hub" onAction="#onIntegrationPlaceholder"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                    <Button text="Workspace Home" onAction="#onIntegrationPlaceholder"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                    <Button text="Friends Directory" onAction="#onIntegrationPlaceholder"
                            style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                </VBox>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Shortcuts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button text="Focus Timer"   onAction="#onGoFocus"              style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                    <Button text="Virtual Rooms" onAction="#onGoRooms"              style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                    <Button text="Leaderboard"   onAction="#onIntegrationPlaceholder" style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 210;"/>
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>
