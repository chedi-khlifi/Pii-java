<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="tn.esprit.GuardianController"
            style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: transparent #e5e7eb transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="200" maxWidth="200" spacing="4">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 16 4;">
                <Label text="🔥" style="-fx-font-size: 16px;"/>
                <Label text="MindForge" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
            </HBox>

            <Button text="📁  Planner"   onAction="#onOpenPlanner"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="👥  Community" onAction="#onOpenCommunity"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="📚  Guardian"  onAction="#onGoHub"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="💼  Careers"   onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="📊  Analyst"   onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>

            <Region minHeight="16"/>
            <Label text="QUICK LINKS" style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: 700; -fx-padding: 0 0 4 4;"/>
            <Button text="Contact Support" onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 6 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="Friends"         onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 6 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
            <Button text="Leaderboard"     onAction="#onIntegrationPlaceholder"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 6 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 176;"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5; -fx-border-color: transparent;">
            <content>
                <VBox spacing="16" style="-fx-background-color: #f0f2f5; -fx-padding: 16 20 24 20;">

                    <!-- Gradient hero banner -->
                    <VBox style="-fx-background-color: linear-gradient(to right, #ec4899, #8b5cf6 50%, #06b6d4); -fx-background-radius: 12;" spacing="4">
                        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                        <Label text="Focus Timer"
                               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Run Pomodoro sessions linked to your tasks."
                               style="-fx-text-fill: white; -fx-opacity: 0.9; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- ── Main Pomodoro card ── -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 20;" spacing="14">

                        <!-- Header: Pomodoro badge + stats pills + View my stats -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🍅 Pomodoro"
                                   style="-fx-background-color: #ede9fe; -fx-text-fill: #7c3aed; -fx-background-radius: 20; -fx-padding: 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="labelTodaySessions" text="Today: 0 sessions"
                                   style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px;"/>
                            <Label fx:id="labelWeekMin" text="This week: 0 min"
                                   style="-fx-background-color: #ede9fe; -fx-text-fill: #5b21b6; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px;"/>
                            <Label fx:id="labelTotalMin" text="Total: 0 min"
                                   style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 11px;"/>
                            <Button text="📊 View my stats" onAction="#onGoFocusStats"
                                    style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 3 8;"/>
                        </HBox>

                        <Label text="Task Focus Sessions"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Pick a task, start the timer, and save your completed focus session."
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>

                        <!-- Task + Duration row -->
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Task" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <ComboBox fx:id="focusTaskField" promptText="-- Select a task --" maxWidth="Infinity"
                                          style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Duration (auto by priority)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <TextField fx:id="focusDurationField" text="25" prefWidth="80"
                                               style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 10;"/>
                                    <Button text="↺" onAction="#onFocusAutoFillDuration"
                                            style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-padding: 7 10; -fx-cursor: hand; -fx-font-size: 13px;"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6" alignment="BOTTOM_RIGHT">
                                <Label text=""/>
                                <Button text="Create task" onAction="#onIntegrationPlaceholder"
                                        style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 7 10;"/>
                            </VBox>
                        </HBox>

                        <!-- Big timer display -->
                        <StackPane alignment="CENTER" style="-fx-padding: 16 0 8 0;">
                            <VBox alignment="CENTER" spacing="8">
                                <Label fx:id="timerDisplay" text="25:00"
                                       style="-fx-font-size: 56px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
                                <Label fx:id="timerStatus" text="Ready to focus"
                                       style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </StackPane>

                        <!-- Timer control buttons -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button text="▶ Start"         onAction="#onFocusStart"
                                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="⏸ Pause"         onAction="#onFocusPause"
                                    style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="↺ Reset"         onAction="#onFocusReset"
                                    style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9 20; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-cursor: hand;"/>
                            <Button text="💾 Save session" onAction="#onFocusCreate"
                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </HBox>

                        <CheckBox fx:id="markDoneOnSave" text="Mark this task as done when saving this session"
                                  style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                    </VBox>

                    <!-- ── AI cards row (Focus Tips + Daily Plan) ── -->
                    <HBox spacing="16">
                        <!-- AI Focus Tips -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 16;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="AI Focus Tips"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="↺ Refresh" onAction="#onAiFocusTips"
                                        style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 11px; -fx-padding: 4 10; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-cursor: hand;"/>
                            </HBox>
                            <Label fx:id="aiFocusTipsLabel" text="Select a task to load AI tips."
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <HBox spacing="6">
                                <Label text="Was this helpful?" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                                <Button text="👍" onAction="#onIntegrationPlaceholder"
                                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 4;"/>
                                <Button text="👎" onAction="#onIntegrationPlaceholder"
                                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 4;"/>
                            </HBox>
                        </VBox>

                        <!-- AI Daily Plan -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 16;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="AI Daily Plan"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="↺ Refresh" onAction="#onDailyPlan"
                                        style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 11px; -fx-padding: 4 10; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-cursor: hand;"/>
                            </HBox>
                            <Label fx:id="aiDailyPlanLabel" text=""
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                        </VBox>
                    </HBox>

                    <!-- ── AI Weekly Review ── -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 16;" spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="AI Weekly Review"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="↺ Refresh" onAction="#onWeeklyReview"
                                    style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 11px; -fx-padding: 4 10; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </HBox>
                        <Label fx:id="aiWeeklyReviewLabel" text=""
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                        <HBox spacing="6">
                            <Label text="Was this helpful?" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                            <Button text="👍" onAction="#onIntegrationPlaceholder"
                                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 4;"/>
                            <Button text="👎" onAction="#onIntegrationPlaceholder"
                                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 0 4;"/>
                        </HBox>
                    </VBox>

                    <!-- ── Top Focused Tasks ── -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 20;" spacing="12">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Top Focused Tasks"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="By total minutes"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                        </HBox>
                        <FlowPane fx:id="focusUserStatsCards" hgap="12" vgap="10" prefWrapLength="900"/>
                    </VBox>

                    <!-- ── Recent Focus Sessions table ── -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-padding: 20;" spacing="12">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Recent Focus Sessions"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="sessionCountLabel" text="Latest 12 entries"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                        </HBox>
                        <!-- Table header -->
                        <HBox style="-fx-border-color: transparent transparent #e5e7eb transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                            <Label text="Task"      style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" HBox.hgrow="ALWAYS" minWidth="200"/>
                            <Label text="Duration"  style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" minWidth="120"/>
                            <Label text="Timestamp" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" minWidth="160"/>
                        </HBox>
                        <!-- Session rows rendered by controller -->
                        <FlowPane fx:id="focusCards" hgap="0" vgap="0" prefWrapLength="9999"/>
                    </VBox>

                    <!-- Hidden controller fields -->
                    <TextField fx:id="focusIdField"    managed="false" visible="false"/>
                    <VBox fx:id="focusMessageContainer" spacing="0" managed="false" visible="false"/>
                    <Label fx:id="focusMessageLabel" text="" managed="false" visible="false"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: transparent transparent transparent #e5e7eb; -fx-border-width: 0 0 0 1;"
              minWidth="220" maxWidth="220" spacing="20">
            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

            <!-- Network -->
            <VBox spacing="8">
                <Label text="Network" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Button text="Workspace Network Hub" onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Workspace Home"        onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Friends Directory"     onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
            </VBox>

            <Region style="-fx-background-color: #e5e7eb; -fx-pref-height: 1; -fx-max-height: 1;"/>

            <!-- Shortcuts -->
            <VBox spacing="8">
                <Label text="Shortcuts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Button text="Focus Timer"   onAction="#onGoFocus"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Virtual Rooms" onAction="#onGoRooms"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Leaderboard"   onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
            </VBox>

            <Region style="-fx-background-color: #e5e7eb; -fx-pref-height: 1; -fx-max-height: 1;"/>

            <!-- Modules -->
            <VBox spacing="8">
                <Label text="Modules" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Button text="Virtual Rooms"    onAction="#onGoRooms"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Careers Center ▾" onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                <Button text="Profile"          onAction="#onIntegrationPlaceholder"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 6 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
            </VBox>

        </VBox>
    </right>

</BorderPane>
