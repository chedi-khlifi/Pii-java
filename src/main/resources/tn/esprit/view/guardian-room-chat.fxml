<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Mirrors: room_detail.html.twig — Chat + Participants + Resources panels -->
<BorderPane fx:controller="tn.esprit.GuardianController"
            stylesheets="@guardian-cards.css"
            style="-fx-background-color: #f5f5fa;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ══ LEFT SIDEBAR ═════════════════════════════════════════════ -->
    <left>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent #e1e3ef transparent transparent; -fx-border-width: 0 1 0 0;"
              minWidth="210" maxWidth="210" spacing="5">
            <padding><Insets top="14" right="12" bottom="14" left="12"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="8" right="10" bottom="10" left="10"/></padding>
                <Label text="🔥" style="-fx-font-size: 20px;"/>
                <Label text="MindForge" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #21273b;"/>
            </HBox>
            <VBox spacing="5">
                <Button text="📁  Planner"   onAction="#onIntegrationPlaceholder"  styleClass="guardian-global-nav-button"/>
                <Button text="👥  Community" onAction="#onOpenCommunity"            styleClass="guardian-global-nav-button"/>
                <Button text="📚  Guardian"  onAction="#onGoHub"                    styleClass="guardian-global-nav-button guardian-global-nav-selected"/>
                <Button text="💼  Careers"   onAction="#onIntegrationPlaceholder"   styleClass="guardian-global-nav-button"/>
                <Button text="📊  Analyst"   onAction="#onIntegrationPlaceholder"   styleClass="guardian-global-nav-button"/>
            </VBox>
            <Region minHeight="20"/>
            <Label text="QUICK LINKS" style="-fx-text-fill: #a0a5b8; -fx-font-weight: 700; -fx-font-size: 11px;">
                <padding><Insets bottom="6" left="8" right="8" top="0"/></padding>
            </Label>
            <Button text="Contact Support" onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link"/>
            <Button text="Friends"         onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link"/>
            <Button text="Leaderboard"     onAction="#onIntegrationPlaceholder" styleClass="guardian-quick-link"/>
        </VBox>
    </left>

    <!-- ══ CENTER ════════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="14" style="-fx-background-color: #f5f5fa;">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- Hero banner with room name + join/leave actions -->
            <VBox spacing="5" styleClass="guardian-hero guardian-hero-rooms">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="← Back to Rooms" onAction="#onGoRooms" styleClass="guardian-action-secondary"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="💬 Collaboration room"
                               style="-fx-background-color: rgba(124,92,255,0.25); -fx-text-fill: #3f2fbf; -fx-background-radius: 20; -fx-padding: 3 10; -fx-font-size: 12px;"/>
                        <Label fx:id="chatRoomTitle" text="Room Chat" styleClass="guardian-hero-title"/>
                    </VBox>
                    <!-- Join / Leave buttons — mirrors room_detail.html.twig action buttons -->
                    <HBox spacing="8">
                        <Button fx:id="btnJoinRoom" text="🚪 Join Room" onAction="#onRoomJoin"
                                styleClass="guardian-action-success"/>
                        <Button fx:id="btnLeaveRoom" text="← Leave Room" onAction="#onRoomLeave"
                                styleClass="guardian-action-secondary"/>
                    </HBox>
                </HBox>
            </VBox>

            <!-- Main content: chat (left 60%) + details/participants/resources (right 40%) -->
            <HBox spacing="14" VBox.vgrow="ALWAYS">

                <!-- ── Chat panel (mirrors room_detail col-lg-8) ── -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="guardian-panel" VBox.vgrow="ALWAYS">
                    <!-- Communication tools -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Communication:" styleClass="guardian-hint"/>
                        <Button text="📹 Daily.co Call"  onAction="#onStartDailyCoCall"  styleClass="guardian-action-success"/>
                        <Button text="🎥 Twilio Video"   onAction="#onStartTwilioVideo"   styleClass="guardian-action-secondary"/>
                        <Button text="🎙 Agora Voice"    onAction="#onStartAgoraVoice"    styleClass="guardian-action-warning"/>
                    </HBox>

                    <Label text="💬 Conversation" styleClass="guardian-section-title"/>

                    <!-- Message list -->
                    <ListView fx:id="roomChatList" VBox.vgrow="ALWAYS" prefHeight="380"
                              style="-fx-background-color: #f8f9ff; -fx-border-color: #e0e3ef; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                    <!-- Send message -->
                    <HBox spacing="8">
                        <TextField fx:id="chatInputField" promptText="Write a message..." HBox.hgrow="ALWAYS"
                                   onAction="#onSendChatMessage"/>
                        <Button text="📨 Send" onAction="#onSendChatMessage" styleClass="guardian-action-primary"/>
                    </HBox>

                    <!-- Resource sharing -->
                    <Label text="Share a resource to chat:" styleClass="guardian-hint"/>
                    <HBox spacing="8">
                        <ComboBox fx:id="chatResourceSelector" prefWidth="300" promptText="Select a resource..." HBox.hgrow="ALWAYS"/>
                        <Button text="📎 Share" onAction="#onShareResource" styleClass="guardian-action-success"/>
                    </HBox>
                </VBox>

                <!-- ── Right column: Details + Participants + Resources (mirrors col-lg-4) ── -->
                <VBox spacing="12" minWidth="260" maxWidth="300">

                    <!-- Room details panel -->
                    <VBox spacing="8" styleClass="guardian-panel">
                        <Label text="ℹ️ Details" styleClass="guardian-section-title"/>
                        <HBox spacing="8">
                            <Label text="Creator:" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;" minWidth="70"/>
                            <Label fx:id="roomCreatorLabel" text="—" style="-fx-font-size: 12px; -fx-text-fill: #21273b;"/>
                        </HBox>
                        <HBox spacing="8">
                            <Label text="Created:" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;" minWidth="70"/>
                            <Label fx:id="roomCreatedLabel" text="—" style="-fx-font-size: 12px; -fx-text-fill: #21273b;"/>
                        </HBox>
                        <HBox spacing="8">
                            <Label text="Capacity:" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;" minWidth="70"/>
                            <Label fx:id="roomCapacityLabel" text="—" style="-fx-font-size: 12px; -fx-text-fill: #21273b;"/>
                        </HBox>
                        <HBox spacing="8">
                            <Label text="Status:" style="-fx-font-size: 12px; -fx-text-fill: #6d748a;" minWidth="70"/>
                            <Label fx:id="roomStatusLabel" text="Active"
                                   style="-fx-background-color: rgba(72,198,239,0.2); -fx-text-fill: #1b4d6b; -fx-background-radius: 10; -fx-padding: 2 8; -fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>

                    <!-- Participants panel (mirrors room_detail col-lg-4 participants section) -->
                    <VBox spacing="8" styleClass="guardian-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="👥 Participants" styleClass="guardian-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="roomParticipantCountLabel" text="0"
                                   style="-fx-background-color: #EEEDFE; -fx-text-fill: #534AB7; -fx-background-radius: 10; -fx-padding: 2 8; -fx-font-size: 11px;"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" prefViewportHeight="120" styleClass="guardian-card-scroll">
                            <content>
                                <FlowPane fx:id="roomParticipantsPane" hgap="8" vgap="6" prefWrapLength="260"
                                          style="-fx-padding: 4;"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- Resources in room (mirrors room_detail "Resources in this room") -->
                    <VBox spacing="8" styleClass="guardian-panel" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="📚 Room Resources" styleClass="guardian-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Manage" onAction="#onIntegrationPlaceholder" styleClass="guardian-action-secondary"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" prefViewportHeight="160" styleClass="guardian-card-scroll">
                            <content>
                                <FlowPane fx:id="roomResourcesPane" hgap="8" vgap="8" prefWrapLength="260"
                                          style="-fx-padding: 4;"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- ══ RIGHT SIDEBAR ════════════════════════════════════════════ -->
    <right>
        <VBox style="-fx-background-color: #f5f5fa; -fx-border-color: transparent transparent transparent #e1e3ef; -fx-border-width: 0 0 0 1;"
              minWidth="220" maxWidth="220" spacing="12">
            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Network" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button text="Workspace Network Hub" onAction="#onIntegrationPlaceholder" style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="Workspace Home"        onAction="#onIntegrationPlaceholder" style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="Friends Directory"     onAction="#onIntegrationPlaceholder" style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                </VBox>
            </VBox>
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e3ef; -fx-border-radius: 10; -fx-background-radius: 10;" spacing="0">
                <Label text="Shortcuts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #565f79;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                </Label>
                <VBox spacing="5">
                    <padding><Insets bottom="8" left="8" right="8" top="0"/></padding>
                    <Button text="Focus Timer"   onAction="#onGoFocus"              style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="Virtual Rooms" onAction="#onGoRooms"              style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                    <Button text="Leaderboard"   onAction="#onIntegrationPlaceholder" style="-fx-background-color: #fbfcff; -fx-border-color: #ebedf7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #59607a; -fx-font-size: 12px; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-min-width: 188;"/>
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>
