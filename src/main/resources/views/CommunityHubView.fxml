<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.controllers.CommunityHubController"
      spacing="0"
      styleClass="community-root">

    <children>
        <!-- Top Navigation -->
        <HBox styleClass="top-navbar" alignment="CENTER_LEFT" style="-fx-padding: 20 40; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <children>
                <Label text="Hub Communautaire" styleClass="section-title" style="-fx-font-size: 32px; -fx-font-weight: 900;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="backButton" text="← Dashboard" onAction="#handleBack" styleClass="secondary-button"/>
            </children>
        </HBox>

        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="50" style="-fx-padding: 60;" alignment="CENTER">
                    <children>
                        <!-- Hero Section (Gradient) -->
                        <VBox spacing="15" alignment="CENTER" styleClass="community-hero" style="-fx-padding: 50; -fx-max-width: 900; -fx-background-radius: 30; -fx-background-color: linear-gradient(to right, #6f42c1, #a29bfe);">
                            <children>
                                <Label text="Bienvenue dans l'Espace Collaboration" styleClass="community-hero-title" style="-fx-font-size: 42px;"/>
                                <Label text="L'endroit idéal pour apprendre, partager et progresser ensemble." style="-fx-text-fill: white; -fx-font-size: 18px; -fx-opacity: 0.9;"/>
                            </children>
                        </VBox>

                        <Separator styleClass="separator" style="-fx-max-width: 900;"/>

                        <!-- Grid of Actions (Modern Cards) -->
                        <FlowPane hgap="40" vgap="40" alignment="CENTER">
                            <children>
                                <VBox styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="💬" style="-fx-font-size: 64px;"/>
                                        <Label text="Salles Virtuelles" styleClass="room-card-title"/>
                                        <Label text="Discutez en direct avec la communauté sur vos sujets préférés." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="roomsButton" text="Parcourir les Salles" onAction="#handleVirtualRooms" styleClass="module-main-action" maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="📬" style="-fx-font-size: 64px;"/>
                                        <Label text="Boîte de Réception" styleClass="room-card-title"/>
                                        <Label text="Découvrez les défis qui vous attendent aujourd'hui." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="inboxButton" text="Voir mes défis" onAction="#handleReceivedChallenges" styleClass="module-main-action" maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="🚀" style="-fx-font-size: 64px;"/>
                                        <Label text="Nouveau Défi" styleClass="room-card-title"/>
                                        <Label text="Créez une tâche et défiez vos collègues avec l'IA." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="sendChallengeButton" text="Créer un défi" onAction="#handleSendChallenge" styleClass="module-main-action" maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="📤" style="-fx-font-size: 64px;"/>
                                        <Label text="Historique Envoyé" styleClass="room-card-title"/>
                                        <Label text="Suivez l'évolution des défis que vous avez lancés." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="sentChallengesButton" text="Suivre mes envois" onAction="#handleSentChallenges" styleClass="module-main-action" maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="🛠️" style="-fx-font-size: 64px;"/>
                                        <Label text="Support" styleClass="room-card-title"/>
                                        <Label text="Une question ? Notre équipe est là pour vous aider." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="claimsButton" text="Accéder au Support" onAction="#handleCreateTicket" styleClass="module-main-action" maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>
                                <VBox styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="🎫" style="-fx-font-size: 64px;"/>
                                        <Label text="Mes Tickets" styleClass="room-card-title"/>
                                        <Label text="Consultez et suivez rapidement vos demandes de support." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="myTicketsBtn" text="Voir mes tickets" onAction="#handleMyTickets" styleClass="module-main-action" maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>
                                <VBox fx:id="adminTicketsCard" styleClass="room-card" prefWidth="350" spacing="25" alignment="CENTER" style="-fx-padding: 40;">
                                    <children>
                                        <Label text="👮" style="-fx-font-size: 64px;"/>
                                        <Label text="Gestion Tickets" styleClass="room-card-title"/>
                                        <Label text="Administrez l'ensemble des demandes de support utilisateur." wrapText="true" styleClass="muted-label" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
                                        <Button fx:id="adminTicketsBtn" text="Gérer les Tickets" onAction="#handleAdminTickets" styleClass="module-main-action" maxWidth="1.7976931348623157E308" style="-fx-background-color: linear-gradient(to bottom right, #e84393, #d63031);"/>
                                    </children>
                                </VBox>
                            </children>
                        </FlowPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
