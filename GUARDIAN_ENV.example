# Guardian module environment variables
# Copy this file and set these variables in IntelliJ run config or Windows environment settings.

# AI
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Google services
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_TOKEN=your-google-oauth-access-token

# Microsoft services
MICROSOFT_GRAPH_TOKEN=your-microsoft-graph-access-token

# Notifications
FIREBASE_SERVER_KEY=your-firebase-server-key
SENDGRID_API_KEY=your-sendgrid-api-key

# Storage
DROPBOX_OAUTH_TOKEN=your-dropbox-oauth-token

# Video / real-time
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERT=your-agora-app-certificate
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
DAILYCO_API_KEY=your-dailyco-api-key

# Security
GUARDIAN_JWT_SECRET=your-jwt-secret-min-32-chars
